+            let n = wps.len();
+            let p = wps[n - 1];
+            let out = normal(side_of(end_rect(sc, end), p));
+            // How far out along the normal, and how far off its line.
+            let along = |q: (f64, f64)| (q.0 - p.0) * out.0 + (q.1 - p.1) * out.1;
+            let off = |q: (f64, f64)| ((q.0 - p.0) * out.1 - (q.1 - p.1) * out.0).abs();
