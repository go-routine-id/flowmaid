+        l0 = l0.min(p.layer);
+        l1 = l1.max(p.layer);
+        m0 = m0.min(p.b - p.bsize / 2.0);
+        m1 = m1.max(p.b + p.bsize / 2.0);
+    }
+    let (mut lo, mut hi) = (f64::NEG_INFINITY, f64::INFINITY);
+    if m0 > m1 {
