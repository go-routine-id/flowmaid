+    for &s in finished.iter().rev() {
+        if comp[s] != usize::MAX {
+            continue;
+        }
+        let mut members = vec![s];
+        comp[s] = s;
+        let mut i = 0;
+        while i < members.len() {
+            let u = members[i];
+            i += 1;
+            for &v in &into[u] {
+                if comp[v] == usize::MAX {
+                    comp[v] = s;
+                    members.push(v);
+                }
+            }
+        }
+        let name = members.iter().copied().min().unwrap_or(s);
+        for v in members {
+            comp[v] = name;
+        }
+    }
