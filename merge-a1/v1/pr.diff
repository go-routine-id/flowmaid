+/// asks a question of the graphs [`scene`] and [`route`] hand on.
+pub(crate) fn any_part(g: &Graph, f: &dyn Fn(&Graph) -> bool) -> bool {
+    match split(g) {
+        Some(s) => s.blocks.iter().any(|(_, p)| any_part(&p.g, f)) || any_part(&s.rest.g, f),
+        None => f(g),
+    }
+}
