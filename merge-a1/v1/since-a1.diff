+  // Roadmap: docs/ROADMAP.md is the one source. It is read from the site and
+  // drawn here, so this section follows the file without a second copy. If it
+  // cannot be read (no JavaScript, a file:// preview) the short text and link stay.
+  (function () {
+    var SOURCE = "../ROADMAP.md";
+    var ON_GITHUB = "https://github.com/go-routine-id/flowmaid/blob/main/docs/ROADMAP.md";
+    var body = document.getElementById("roadmap-body");
+    if (!body || !window.fetch) return;
+    // Whether the reader has moved the page themselves since it opened.
+    var touched = false;
+    ["wheel", "touchstart", "keydown", "mousedown"].forEach(function (t) {
+      addEventListener(t, function () { touched = true; }, { once: true, passive: true });
+    });
+
+    function esc(s) {
+      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+    }
+    // Links are relative to docs/ROADMAP.md, so they resolve against the file on GitHub.
+    function href(u) {
+      var url;
+      try { url = new URL(u, ON_GITHUB); } catch (e) { return null; }
+      return /^https?:$/.test(url.protocol) ? url.href : null;
+    }
+    // Inline markup used by the file: `code`, [text](url) and **bold**.
+    function inline(s) {
+      var keep = [];
+      function hold(html) { keep.push(html); return "\u0000" + (keep.length - 1) + "\u0000"; }
+      s = s.replace(/`([^`]+)`/g, function (_, c) { return hold("<code>" + esc(c) + "</code>"); });
+      s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (_, t, u) {
+        var h = href(u);
+        return h ? hold('<a href="' + esc(h) + '">') + t + hold("</a>") : t;
+      });
+      s = esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
+      return s.replace(/\u0000(\d+)\u0000/g, function (_, n) { return keep[+n]; });
+    }
+    function cells(row) {
+      return row.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map(function (c) { return c.trim(); });
+    }
+    function table(rows) {
+      var html = '<div class="tbl"><table><tr>';
+      cells(rows[0]).forEach(function (c) { html += "<th>" + inline(c) + "</th>"; });
+      html += "</tr>";
+      rows.slice(1).forEach(function (r) {
+        if (/^[\s|:-]+$/.test(r)) return;               // the |---| line under the head
+        html += "<tr>";
+        cells(r).forEach(function (c) { html += "<td>" + inline(c) + "</td>"; });
+        html += "</tr>";
+      });
+      return html + "</table></div>";
+    }
+    // Bullets, nested by two spaces of indent.
+    function list(items) {
+      var html = "", depth = -1;
+      items.forEach(function (it) {
+        var d = Math.min(it.d, depth + 1);
+        if (d > depth) html += "<ul><li>";
+        else {
+          html += "</li>";
+          for (; depth > d; depth--) html += "</ul></li>";
+          html += "<li>";
+        }
+        depth = d;
+        html += inline(it.t);
+      });
+      html += "</li>";
+      for (; depth > 0; depth--) html += "</ul></li>";
+      return html + "</ul>";
+    }
+    function render(md) {
+      var lines = md.replace(/\r/g, "").split("\n"), out = [], para = [], i = 0, m;
+      function flush() { if (para.length) out.push("<p>" + inline(para.join(" ")) + "</p>"); para = []; }
+      function special(l) { return /^\s*(#|\||[-*]\s)/.test(l); }
+      while (i < lines.length) {
+        var l = lines[i];
+        if (!l.trim()) { flush(); i++; }
+        else if ((m = /^(#{1,6})\s+(.*)$/.exec(l))) {
+          flush(); i++;
+          // The section has its own title, so the file's "# Roadmap" is left out.
+          var tag = m[1].length === 2 ? "h3" : "h4";
+          if (m[1].length > 1) out.push("<" + tag + ">" + inline(m[2]) + "</" + tag + ">");
+        } else if (/^\s*\|/.test(l)) {
+          flush();
+          var rows = [];
+          while (i < lines.length && /^\s*\|/.test(lines[i])) rows.push(lines[i++]);
+          out.push(table(rows));
+        } else if (/^\s*[-*]\s/.test(l)) {
+          flush();
+          var items = [];
+          while (i < lines.length && lines[i].trim() && (/^\s*[-*]\s/.test(lines[i]) || !special(lines[i]))) {
+            if ((m = /^(\s*)[-*]\s+(.*)$/.exec(lines[i]))) items.push({ d: Math.floor(m[1].length / 2), t: m[2] });
+            else items[items.length - 1].t += " " + lines[i].trim();
+            i++;
+          }
+          out.push(list(items));
+        } else { para.push(l.trim()); i++; }
+      }
+      flush();
+      return out.join("\n");
+    }
