+/// length — a state a bar branches to, or a member, however deep, of a
+/// composite one (whose breadth is [`frame_breadth`] of its members).
+/// All `false` without a bar. [`crate::compound`] asks it of each
+/// block's proxy: such a proxy must count at its block's frame as the
+/// static layout draws it, whatever the frame is now.
+pub(crate) fn bar_branches(g: &Graph) -> Vec<bool> {
+    let mut out = vec![false; g.nodes.len()];
+    let is_bar = |end: End| matches!(end, End::Node(v) if g.nodes[v].shape == Shape::ForkBar);
+    if !g.nodes.iter().any(|n| n.shape == Shape::ForkBar) {
