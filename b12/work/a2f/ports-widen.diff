+    let longest = free
+        .iter()
+        .copied()
+        .max_by(|x, y| (x.1 - x.0).total_cmp(&(y.1 - y.0)));
+    match longest {
+        Some((p, q)) if shaded && q - p >= need => (p, q, true),
+        // A title-row side of a block layout (`deep`) whose free stretch
+        // is short of its ends takes only the shortfall from the chip's
+        // shade next to it, not the whole side: its ends keep as clear of
+        // the chip as they can at the spacing. Spread over the whole side,
+        // every end jumped under the chip once the stretch was a pixel
+        // short, and the router took such an entry round along the title
+        // strip, across its fan (dense-td's `n42` under `g9`'s chip: four
+        // ends, 32 px free of the 42 they need, once the nested `g10`, grown
+        // to its title, measures it bold and the layout shifts).
+        Some((p, q)) if shaded && deep.iter().any(|&d| d) && hi - lo >= need => {
+            let short = need - (q - p);
+            if p > lo {
+                let a = (p - short).max(lo);
+                (a, (a + need).min(hi), true)
+            } else {
+                let b = (q + short).min(hi);
+                (b - need, b, true)
+            }
+        }
         _ => (lo, hi, false),
     }
 }
