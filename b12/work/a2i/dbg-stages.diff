+fn dbgw(tag: &str, sc: &Scene) {
+    if std::env::var_os("FMDBGE").is_none() { return; }
+    let want = std::env::var("FMDBGE").unwrap();
+    for e in &sc.edges { if format!("{}->{}", e.from, e.to) == want {
+        let w: Vec<String> = e.waypoints.iter().map(|p| format!("({:.1},{:.1})", p.0, p.1)).collect();
+        eprintln!("[{}] bez=({:.1},{:.1})..({:.1},{:.1}) n={} {}", tag, e.bezier[0].0, e.bezier[0].1, e.bezier[3].0, e.bezier[3].1, w.len(), w.join(" "));
+    } }
+}
