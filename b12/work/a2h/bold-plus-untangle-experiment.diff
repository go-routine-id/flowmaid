+/// B12 2.8, node-side end order (block layouts, the static scene): the
+/// ends of a node side stand in the order their paths head off it, so
+/// a fan does not cross itself. After the router and the comb a side
+/// can hold two ends whose first steps go the other way round from
+/// their ports (dense-td: `n16`'s bottom, where a reroute of `n16 ->
+/// n35` left its port left of `n16 -> n32`'s while it heads right and
+/// `n16 -> n32` steps left across it). Per side with two or more ends
+/// whose edges cross each other: the ends take the side's places in
+/// the order of where each path first turns to across the side (its
+/// first point off the end's own column), and the change is kept only
+/// when the side's edges then cross each other and everything else
+/// less often than before. Only the ends' own places are exchanged:
+/// each straight leg out of the side follows its end ([`move_end`]).
+pub(crate) fn untangle_sides(sc: &mut Scene, cx: &Ctx, moved: &mut [bool]) {
+    if !cx.blocks {
+        return;
+    }
+    type Ends = std::collections::BTreeMap<(usize, Side), Vec<(f64, usize, bool)>>;
+    let mut groups: Ends = Ends::new();
+    for i in 0..sc.edges.len() {
+        if !cx.drawn.get(i).copied().unwrap_or(false)
+            || cx.fixed.get(i).copied().unwrap_or(false)
+            || cx.held.get(i).copied().unwrap_or(false)
+            || sc.edges[i].waypoints.len() < 2
+        {
+            continue;
+        }
+        let Some((a, b)) = cx.ends.get(i).copied().flatten() else {
+            continue;
+        };
+        if a == b {
+            continue;
+        }
+        for (src, end) in [(true, a), (false, b)] {
+            let EndRef::Node(v) = end else {
+                continue;
+            };
+            let r = end_rect(sc, end);
+            let p = end_point(sc, i, src);
+            let side = side_of(r, p);
+            groups
+                .entry((v, side))
+                .or_default()
+                .push((split(side, p).0, i, src));
+        }
+    }
+    let lines: Vec<Vec<Pt>> = sc.edges.iter().map(edge_polyline).collect();
+    let cross = |a: &[Pt], b: &[Pt]| -> usize {
+        let mut n = 0;
+        for u in a.windows(2) {
+            for v in b.windows(2) {
+                n += usize::from(segs_cross(u[0], u[1], v[0], v[1]));
+            }
+        }
+        n
+    };
+    for ((_, side), mut ends) in groups {
+        if ends.len() < 2 {
+            continue;
+        }
+        let idx: Vec<usize> = ends.iter().map(|e| e.1).collect();
+        let tangled = (0..idx.len()).any(|a| {
+            (a + 1..idx.len()).any(|b| idx[a] != idx[b] && cross(&lines[idx[a]], &lines[idx[b]]) > 0)
+        });
+        if !tangled {
+            continue;
+        }
+        ends.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+        // Where each path first turns to across the side.
+        let heading = |i: usize, src: bool, at: f64| -> f64 {
+            let w = &sc.edges[i].waypoints;
+            let pts: Vec<Pt> = if src {
+                w.clone()
+            } else {
+                w.iter().rev().copied().collect()
+            };
+            pts.iter()
+                .map(|&q| split(side, q).0)
+                .find(|&t| (t - at).abs() > PORT_EPS)
+                .unwrap_or(at)
+        };
+        let mut by_key: Vec<(f64, f64, usize, bool)> = ends
+            .iter()
+            .map(|&(at, i, src)| (heading(i, src, at), at, i, src))
+            .collect();
+        by_key.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.total_cmp(&b.1)));
+        let places: Vec<f64> = ends.iter().map(|e| e.0).collect();
+        if by_key
+            .iter()
+            .zip(&places)
+            .all(|(k, &t)| (t - k.1).abs() <= PORT_EPS)
+        {
+            continue;
+        }
+        let mine: Vec<usize> = {
+            let mut m: Vec<usize> = ends.iter().map(|e| e.1).collect();
+            m.sort_unstable();
+            m.dedup();
+            m
+        };
+        let count = |sc: &Scene| -> usize {
+            let own: Vec<Vec<Pt>> = mine.iter().map(|&i| edge_polyline(&sc.edges[i])).collect();
+            let mut n = 0;
+            for (a, &i) in mine.iter().enumerate() {
+                for (j, line) in lines.iter().enumerate() {
+                    if mine.contains(&j) || j == i || !cx.drawn.get(j).copied().unwrap_or(false) {
+                        continue;
+                    }
+                    n += cross(&own[a], line);
+                }
+                for b in a + 1..mine.len() {
+                    n += cross(&own[a], &own[b]);
+                }
+            }
+            n
+        };
+        let before = count(sc);
+        let was: Vec<SceneEdge> = mine.iter().map(|&i| sc.edges[i].clone()).collect();
+        for (k, &(_, at, i, src)) in by_key.iter().enumerate() {
+            let t = places[k];
+            if (t - at).abs() <= PORT_EPS {
+                continue;
+            }
+            let p = end_point(sc, i, src);
+            let (_, line) = split(side, p);
+            let new = join(side, t, line);
+            let delta = (new.0 - p.0, new.1 - p.1);
+            move_end(&mut sc.edges[i], src, p, delta, side, false, false);
+        }
+        if count(sc) < before {
+            for &i in &mine {
+                if let Some(m) = moved.get_mut(i) {
+                    *m = true;
+                }
+            }
+        } else {
+            for (&i, e) in mine.iter().zip(was) {
+                sc.edges[i] = e;
+            }
+        }
+    }
+}
