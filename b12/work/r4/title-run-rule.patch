+    /// Title-clear channels, by their place in the title row. A channel
+    /// that enters (or leaves) a block through its title side runs down
+    /// the block's title row as a unit of the block; standing before the
+    /// members the title chip reaches over, it would cross the frame
+    /// under the chip — the title struck — and the router takes it
+    /// round, out through a side wall of the block (the nested-chain
+    /// fixture: `a -> c2` left `Inner source` and came back in through
+    /// the side of `Inner target`, outside the frame that holds both).
+    /// So such a channel point stands past the members the chip reaches
+    /// over: it moves along its row, away from the title's end, until
+    /// its place lies beyond the chip ([`BlockOrder::chip`]) by the
+    /// least room the row's members and gaps take up to it — passing
+    /// plain nodes only, never a child block (it keeps one side of that
+    /// on every layer) nor another channel (two channels with one clear
+    /// place between them would pass each other for ever), and only
+    /// when that clears it. The last in the row first, so those moved
+    /// keep their order. The coordinates then place it at least that
+    /// far from the frame's edge: every separation they keep is at
+    /// least the one counted here.
+    fn clear_titles(&self, layer: &mut Vec<usize>) {
+        let Some(&first) = layer.first() else {
+            return;
+        };
+        let Some(levels) = self.titled.get(self.alayer[first]) else {
+            return;
+        };
+        // Least distance between two neighbours' centres ([`pair_sep`]
+        // without the room of a box border between them).
+        let apart = |u: usize, v: usize| {
+            let half = |x: usize| {
+                if x < self.real {
+                    GAP_B / 2.0
+                } else {
+                    EDGE_GAP / 2.0
+                }
+            };
+            let base = if self.border[u] != 0 || self.border[v] != 0 {
+                BORDER_GAP
+            } else {
+                half(u) + half(v)
+            };
+            self.size[u] / 2.0 + base + self.size[v] / 2.0
+        };
+        for &li in levels {
+            let (path, _, _) = &self.levels[li];
+            let Some(&c) = path.last() else {
+                continue;
+            };
+            let need = self.chip[c];
+            if need <= 0.0 {
+                continue;
+            }
+            // Each pass moves one channel point further on, past nodes
+            // alone, and puts none that stood clear back under the
+            // chip: it ends.
+            loop {
+                let units = self.units(layer, path);
+                let Some(&(_, start, _)) = units.first() else {
+                    break;
+                };
+                // The least place of the item at `at`, from the frame's
+                // edge, with the item `skip` taken out of the row.
+                let place = |at: usize, skip: Option<usize>| -> f64 {
+                    let mut prev: Option<usize> = None;
+                    let mut x = 0.0;
+                    for (i, &v) in layer.iter().enumerate().take(at + 1).skip(start) {
+                        if Some(i) == skip {
+                            continue;
+                        }
+                        x = match prev {
+                            // (A frame keeps its pad off a member, a
+                            // lane's off a channel inside it.)
+                            None => FRAME_PAD.min(TITLE_RUN_PAD) + self.size[v] / 2.0,
+                            Some(u) => x + apart(u, v),
+                        };
+                        prev = Some(v);
+                    }
+                    x
+                };
+                let mut moved = false;
+                for (i, &(u, at, _)) in units.iter().enumerate().rev() {
+                    if !matches!(u, OrderUnit::Run(_)) || place(at, None) >= need {
+                        continue;
+                    }
+                    // The first unit past which it stands clear.
+                    let d = layer[at];
+                    let to = units[i + 1..]
+                        .iter()
+                        .take_while(|w| matches!(w.0, OrderUnit::Node(_)))
+                        .map(|w| w.1 + w.2 - 1)
+                        .find(|&last| place(last, Some(at)) + apart(layer[last], d) >= need);
+                    if let Some(last) = to {
+                        layer[at..=last].rotate_left(1);
+                        moved = true;
+                        break;
+                    }
