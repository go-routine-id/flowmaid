+/// The least room (px) a frame keeps between its edge and a channel
+/// inside it (the scene's lane pad): what [`BlockOrder::clear_titles`]
+/// counts from the frame's edge to a title row's first channel.
+const TITLE_RUN_PAD: f64 = 12.0;
+
+/// How far (px) from the title-end edge of its frame a channel must
+/// cross a block's title side to pass clear of the title chip: the
+/// chip's own reach along the side (its inset, the title at the title
+/// font, its padding — as [`crate::scene::title_head`] draws it), the
+/// room an edge keeps off a chip ([`crate::clearance::CHIP_SEP`]) and a
+/// corner's rounding ([`crate::router::CORNER_R`]: a channel that steps
+/// just before the frame turns into its column on an arc that cuts the
+/// corner, towards the chip). 0 for an empty title.
+fn title_reach(title: &str) -> f64 {
+    use crate::clearance::{CHIP_INSET_X, CHIP_PAD_W, CHIP_SEP};
+    if title.trim().is_empty() {
+        return 0.0;
+    }
+    CHIP_INSET_X
+        + text_width(title) * TITLE_SCALE
+        + CHIP_PAD_W
+        + CHIP_SEP
+        + crate::router::CORNER_R
+}
