+        let p = w[idx(0)];
+        let b = w[idx(1)];
+        let along_y = (b.0 - p.0).abs() < 1e-6 && (b.1 - p.1).abs() > 1e-6;
+        let along_x = (b.1 - p.1).abs() < 1e-6 && (b.0 - p.0).abs() > 1e-6;
+        if !along_x && !along_y {
+            continue;
+        }
+        let on = |q: (f64, f64)| if along_y { (q.0 - p.0).abs() < 1e-6 } else { (q.1 - p.1).abs() < 1e-6 };
+        // The corner: the last point back on the run's line before one off it.
+        let mut k = 1;
+        while k + 1 < n && on(w[idx(k + 1)]) {
+            k += 1;
+        }
+        if k + 1 >= n || k < 2 {
+            continue;
+        }
+        let c = w[idx(k)];
+        let a = w[idx(k + 1)];
+        let run = (c.0 - p.0).hypot(c.1 - p.1);
+        let r_after = (c.0 - w[idx(k - 1)].0).hypot(c.1 - w[idx(k - 1)].1);
+        let r_before = (c.0 - a.0).hypot(c.1 - a.1);
+        if run - r_after >= head || run <= head || k != 2 {
+            continue;
+        }
+        let r = (run - head).max(0.5);
+        if r >= r_after {
+            continue;
+        }
+        let towards = |from: (f64, f64), to: (f64, f64), d: f64| {
+            let l = (to.0 - from.0).hypot(to.1 - from.1);
