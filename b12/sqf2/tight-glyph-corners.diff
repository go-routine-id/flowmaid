+/// Room (px) past an end glyph's length ([`crate::scene::edge_head_len`])
+/// that [`tight_glyph_corners`] keeps straight before the glyph: its
+/// base then lies on the run, not on the corner's rounding.
+const GLYPH_RUN_SPARE: f64 = 1.0;
+
+/// In a block layout's static scene, the corner before an end glyph of
+/// a waypoint path turns no wider than leaves the glyph's length (and
+/// [`GLYPH_RUN_SPARE`]) of straight run before the end: a short final
+/// run (a router reroute's 12.5 px stub into a flank: bench-75 drawn LR
+/// as blocks, `svc1 --> logs`) took a rounding of half its length, which
+/// put the head's base on the curve and painted the head 52 deg off the
+/// run (the static `DEFECT_BASELINE`'s `end_kink`). The corner keeps its
+/// place; only its rounding points move in, the one before it as far as
+/// the one after when they stood alike. Only a path in the corner form
+/// ([`crate::ports::reround`]'s: end, rounding point, corner) and a run on
+/// an axis. Not in `route()`: there the tighter corner of bench-75's
+/// reroutes came onto another edge's corner (`overlap_pairs` +1 drawn
+/// LR and RL), where the static scene has none.
+fn tight_glyph_corners(e: &mut crate::scene::SceneEdge) {
+    let n = e.waypoints.len();
+    if e.paint_width.is_some() || n < 4 {
+        return;
+    }
+    let run_len = crate::scene::edge_head_len(e) + GLYPH_RUN_SPARE;
+    for (at_start, glyph) in [
+        (false, e.ends.end_marker(e.kind).is_some()),
+        (true, e.ends.start_marker(e.kind).is_some()),
+    ] {
+        if !glyph {
+            continue;
+        }
+        let idx = |k: usize| if at_start { k } else { n - 1 - k };
+        let w = &mut e.waypoints;
+        let (p, b, c, a) = (w[idx(0)], w[idx(1)], w[idx(2)], w[idx(3)]);
+        // End, rounding point and corner on one axis-aligned line, the
+        // point before the corner off it, across.
+        let on_x = (b.1 - p.1).abs() < 1e-6 && (c.1 - p.1).abs() < 1e-6;
+        let on_y = (b.0 - p.0).abs() < 1e-6 && (c.0 - p.0).abs() < 1e-6;
+        let off = if on_x {
+            (a.1 - c.1).abs() > 1e-6 && (a.0 - c.0).abs() < 1e-6
+        } else {
+            on_y && (a.0 - c.0).abs() > 1e-6 && (a.1 - c.1).abs() < 1e-6
+        };
+        if !(on_x || on_y) || !off {
+            continue;
+        }
+        let d = |u: Pt, v: Pt| (u.0 - v.0).hypot(u.1 - v.1);
+        let (run, after, before) = (d(c, p), d(c, b), d(c, a));
+        if run - after >= run_len || run <= run_len || after >= run || before <= 1e-6 {
+            continue;
+        }
+        let r = run - run_len;
+        let toward = |to: Pt, l: f64| (c.0 + (to.0 - c.0) / l * r, c.1 + (to.1 - c.1) / l * r);
+        w[idx(1)] = toward(b, after);
+        if (before - after).abs() <= 1e-6 {
+            w[idx(3)] = toward(a, before);
+        }
+    }
+}
