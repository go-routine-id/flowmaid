+    edges.extend(subs.into_iter().flatten());
+    let mut clusters: Vec<(usize, SceneCluster)> = root
+        .clusters
+        .into_iter()
+        .map(|(si, c)| {
+            (
+                si,
+                SceneCluster {
+                    depth: cx.chains[si].len() - 1,
+                    ..c
+                },
+            )
+        })
+        .collect();
+    clusters.sort_by_key(|(si, c)| (c.depth, *si));
+    let mut out = Scene {
+        nodes,
+        edges,
+        clusters: clusters.into_iter().map(|(_, c)| c).collect(),
+        width: 0.0,
+        height: 0.0,
+    };
+    refit(&mut out, Mode::Static, true);
+    Some(out)
+}
