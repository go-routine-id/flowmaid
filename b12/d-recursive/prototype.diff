+    let mut edges: Vec<Option<SceneEdge>> = vec![None; g.edges.len()];
+    let mut subs: Vec<Option<SceneEdge>> = vec![None; g.sub_edges.len()];
+    for (xi, e) in root.done {
+        let x = &cx.xs[xi];
+        match x.sub {
+            None => edges[x.idx] = Some(e),
+            Some(j) => subs[j] = Some(e),
+        }
+    }
+    // Invisible links and anything left: a straight stand-in.
+    for x in &cx.xs {
+        if x.sub.is_none() && edges[x.idx].is_none() {
+            let (End::Node(a), End::Node(b)) = (x.a, x.b) else { continue };
+            let pts = vec![(nodes[a].x, nodes[a].y), (nodes[b].x, nodes[b].y)];
+            let mut e = mk_edge(x, pts, None);
+            e.waypoints.clear();
+            if !x.invisible() {
