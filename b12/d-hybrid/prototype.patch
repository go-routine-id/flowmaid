+/// B12 prototype: NESTED ("block") ranking. Every subgraph is one unit
+/// of the level it lives in: a level's units (its direct member nodes
+/// and its direct child subgraphs) are layered by longest path over the
+/// links between them, a subgraph counting as many rows as its own
+/// inside needs; a node's layer is the sum of its ancestors' starts and
+/// its own. So a subgraph's members take CONSECUTIVE layers, and two
+/// sibling subgraphs a link joins never share a layer.
+///
+/// A level whose links between units close a cycle is broken by a DFS
+/// over its units in declaration order (sources first), each unit's
+/// links followed in the declaration order of their targets: the links
+/// into a unit still on the stack are turned round (`back` and `up`).
+fn block_rank(
+    g: &Graph,
+    nc: &[Vec<usize>],
+    adj: &[Vec<(usize, usize)>],
+    n: usize,
+    back: &mut [bool],
+    up: &mut [bool],
+    layer: &mut [usize],
+) {
+    let ns = g.subgraphs.len();
+    let nx = adj.len();
+    let root = ns;
+    // Each subgraph's parent level and depth, from the member paths (an
+    // empty subgraph is on no path: no unit).
+    let mut parent = vec![usize::MAX; ns];
+    let mut depth = vec![0usize; ns];
+    let mut first = vec![usize::MAX; ns];
+    for (v, path) in nc.iter().enumerate() {
+        for (i, &c) in path.iter().enumerate() {
+            if first[c] == usize::MAX {
+                first[c] = v;
+                parent[c] = if i == 0 { root } else { path[i - 1] };
+                depth[c] = i;
+            }
+        }
+    }
+    // Unit ids: node v = v, subgraph c = n + c. Declaration key of a
+    // unit: its (first) node.
+    let key = |u: usize| if u < n { u } else { first[u - n] };
+    // The level a link belongs to and its two units there.
+    let split = |a: usize, b: usize| -> (usize, usize, usize) {
+        let (pa, pb) = (&nc[a], &nc[b]);
+        let k = pa.iter().zip(pb.iter()).take_while(|(x, y)| x == y).count();
+        let lvl = if k == 0 { root } else { pa[k - 1] };
+        let ua = if pa.len() > k { n + pa[k] } else { a };
+        let ub = if pb.len() > k { n + pb[k] } else { b };
+        (lvl, ua, ub)
+    };
+    // Node-level links: real edges and each rank-only group's from x to
+    // pairs, with the ranking links they stand for.
+    let mut links: Vec<(usize, usize, Vec<usize>)> = Vec::new();
+    for u in 0..n {
+        for &(v, ei) in &adj[u] {
+            if v < n {
+                if u != v && !back[ei] {
+                    links.push((u, v, vec![ei]));
+                }
+            }
+        }
+    }
+    for h in n..nx {
+        let ins: Vec<(usize, usize)> = (0..n)
+            .flat_map(|a| {
+                adj[a]
+                    .iter()
+                    .filter(move |&&(t, _)| t == h)
+                    .map(move |&(_, ei)| (a, ei))
+            })
+            .collect();
+        for &(a, ein) in &ins {
+            for &(b, eout) in &adj[h] {
+                if a != b && b < n && !back[ein] && !back[eout] {
+                    links.push((a, b, vec![ein, eout]));
+                }
+            }
+        }
+    }
+    // Per level: its links between units.
+    let mut level_links: Vec<Vec<(usize, usize, usize)>> = vec![Vec::new(); ns + 1];
+    for (li, &(a, b, _)) in links.iter().enumerate() {
+        let (lvl, ua, ub) = split(a, b);
+        level_links[lvl].push((ua, ub, li));
+    }
+    // Per level: its units.
+    let mut units: Vec<Vec<usize>> = vec![Vec::new(); ns + 1];
+    for v in 0..n {
+        units[nc[v].last().copied().unwrap_or(root)].push(v);
+    }
+    for c in 0..ns {
+        if first[c] != usize::MAX {
+            units[parent[c]].push(n + c);
+        }
+    }
+    // Deepest levels first, the root last.
+    let mut order: Vec<usize> = (0..ns).filter(|&c| first[c] != usize::MAX).collect();
+    order.sort_by_key(|&c| (std::cmp::Reverse(depth[c]), c));
+    order.push(root);
+    // Rows a unit takes, and its start within its level.
+    let mut rows = vec![1usize; n + ns];
+    let mut rel = vec![0usize; n + ns];
+    let mut turned = vec![false; links.len()];
+    let tight = b12_opt("TIGHT");
+    for &lvl in &order {
+        let us = &mut units[lvl];
+        us.sort_by_key(|&u| (key(u), u));
+        let us: &Vec<usize> = us;
+        let m = us.len();
+        let at = |u: usize| us.binary_search_by_key(&(key(u), u), |&x| (key(x), x)).unwrap();
+        let mut out: Vec<Vec<(usize, usize)>> = vec![Vec::new(); m];
+        let mut indeg = vec![0usize; m];
+        for &(ua, ub, li) in &level_links[lvl] {
+            out[at(ua)].push((at(ub), li));
+            indeg[at(ub)] += 1;
+        }
+        for l in out.iter_mut() {
+            l.sort_unstable();
+        }
+        // Cycle breakers of the level: two walks over its units, one
+        // from its sources first, one in plain declaration order; the
+        // one turning fewer links wins, the sources' walk on a tie.
+        let walk = |roots: Vec<usize>| -> Vec<usize> {
+            let mut state = vec![0u8; m];
+            let mut cut = Vec::new();
+            for s in roots {
+                if state[s] != 0 {
+                    continue;
+                }
+                state[s] = 1;
+                let mut stack: Vec<(usize, usize)> = vec![(s, 0)];
+                while let Some(&(u, ci)) = stack.last() {
+                    if ci < out[u].len() {
+                        stack.last_mut().unwrap().1 += 1;
+                        let (v, li) = out[u][ci];
+                        match state[v] {
+                            0 => {
+                                state[v] = 1;
+                                stack.push((v, 0));
+                            }
+                            1 => cut.push(li),
+                            _ => {}
+                        }
+                    } else {
+                        state[u] = 2;
+                        stack.pop();
+                    }
+                }
+            }
+            cut
+        };
+        let cost = |cut: &[usize]| cut.iter().filter(|&&li| links[li].2.len() == 1).count();
+        let from_sources = walk((0..m).filter(|&i| indeg[i] == 0).chain(0..m).collect());
+        let declared = walk((0..m).collect());
+        let two = std::env::var("FMB12_ORDER").map_or(true, |v| v != "model");
+        let cut = if two && cost(&declared) < cost(&from_sources) {
+            declared
+        } else {
+            from_sources
+        };
+        for li in cut {
+            turned[li] = true;
+        }
+        // The fewest links against the flow (exact, by subsets, up to
+        // 12 units a level; ties to declaration order), taken instead of
+        // the walk's when the walk turns over twice as many (`half`) or
+        // always (`fas`).
+        let mode = std::env::var("FMB12_ORDER").unwrap_or_default();
+        if (mode == "fas" || mode == "half") && m >= 2 && m <= 12 {
+            let weight = |li: usize| -> u64 {
+                if links[li].2.len() == 1 {
+                    1000
+                } else {
+                    1
+                }
+            };
+            let mut w = vec![vec![0u64; m]; m];
+            for i in 0..m {
+                for &(j, li) in &out[i] {
+                    w[i][j] += weight(li);
+                }
+            }
+            let walk_cost: u64 = (0..m)
+                .flat_map(|i| out[i].iter())
+                .filter(|&&(_, li)| turned[li])
+                .map(|&(_, li)| weight(li))
+                .sum();
+            let full = (1usize << m) - 1;
+            let mut f = vec![0u64; full + 1];
+            for set in (0..full).rev() {
+                let mut best = u64::MAX;
+                for j in 0..m {
+                    if set & (1 << j) != 0 {
+                        continue;
+                    }
+                    let c: u64 = (0..m)
+                        .filter(|&i| i != j && set & (1 << i) == 0)
+                        .map(|i| w[i][j])
+                        .sum();
+                    best = best.min(c + f[set | (1 << j)]);
+                }
+                f[set] = best;
+            }
+            if mode == "fas" || 2 * f[0] + 1000 < walk_cost {
+                let mut pos = vec![0usize; m];
+                let mut set = 0usize;
+                for k in 0..m {
+                    for j in 0..m {
+                        if set & (1 << j) != 0 {
+                            continue;
+                        }
+                        let c: u64 = (0..m)
+                            .filter(|&i| i != j && set & (1 << i) == 0)
+                            .map(|i| w[i][j])
+                            .sum();
+                        if c + f[set | (1 << j)] == f[set] {
+                            pos[j] = k;
+                            set |= 1 << j;
+                            break;
+                        }
+                    }
+                }
+                for i in 0..m {
+                    for &(j, li) in &out[i] {
+                        turned[li] = pos[i] > pos[j];
+                    }
+                }
+            }
+        }
+        // Longest path, a unit as deep as its rows.
+        let h: Vec<usize> = us.iter().map(|&u| rows[u]).collect();
+        let mut cons: Vec<(usize, usize)> = Vec::new();
+        for i in 0..m {
+            for &(j, li) in &out[i] {
+                cons.push(if turned[li] { (j, i) } else { (i, j) });
+            }
+        }
+        cons.sort_unstable();
+        cons.dedup();
+        let relax = |cons: &[(usize, usize)]| -> Vec<usize> {
+            let mut start = vec![0usize; m];
+            // Bellman-Ford style: the constraint graph is acyclic.
+            for _ in 0..=m {
+                let mut moved = false;
+                for &(i, j) in cons {
+                    if start[i] + h[i] > start[j] {
+                        start[j] = start[i] + h[i];
+                        moved = true;
+                    }
+                }
+                if !moved {
+                    break;
+                }
+            }
+            start
+        };
+        let mut start = relax(&cons);
+        // Two sibling blocks never interleave: where their rows overlap
+        // without one holding the other's, the later one starts below.
+        if !b12_opt("NOBAND") {
+            for _ in 0..m * m {
+                let mut add = None;
+                'find: for i in 0..m {
+                    for j in 0..m {
+                        if i == j || us[i] < n || us[j] < n {
+                            continue;
+                        }
+                        let (a0, a1) = (start[i], start[i] + h[i]);
+                        let (b0, b1) = (start[j], start[j] + h[j]);
+                        if a0 < b0 && b0 < a1 && a1 < b1 {
+                            add = Some((i, j));
+                            break 'find;
+                        }
+                    }
+                }
+                let Some(c) = add else { break };
+                cons.push(c);
+                start = relax(&cons);
+            }
+        }
+        // A source block starts just above its nearest successor.
+        if tight {
+            for i in 0..m {
+                if us[i] < n && !b12_opt("TIGHTALL") {
+                    continue;
+                }
+                if cons.iter().any(|&(_, j)| j == i) {
+                    continue;
+                }
+                let near = cons
+                    .iter()
+                    .filter(|&&(a, _)| a == i)
+                    .map(|&(_, j)| start[j])
+                    .min();
+                if let Some(near) = near {
+                    if near >= h[i] {
+                        start[i] = near - h[i];
+                    }
+                }
+            }
+        }
+        for (i, &u) in us.iter().enumerate() {
+            rel[u] = start[i];
+        }
+        if lvl != root {
+            rows[n + lvl] = (0..m).map(|i| start[i] + h[i]).max().unwrap_or(1).max(1);
+        }
+    }
+    // Absolute layers, outermost first.
+    let mut abs = vec![0usize; ns + 1];
+    let mut down: Vec<usize> = (0..ns).filter(|&c| first[c] != usize::MAX).collect();
+    down.sort_by_key(|&c| (depth[c], c));
+    for c in down {
+        abs[c] = abs[parent[c]] + rel[n + c];
+    }
+    for v in 0..n {
+        layer[v] = abs[nc[v].last().copied().unwrap_or(root)] + rel[v];
+    }
+    for (li, (_, _, ids)) in links.iter().enumerate() {
+        if turned[li] {
+            for &ei in ids {
+                back[ei] = true;
+                up[ei] = true;
+            }
+        }
+    }
+    // Hubs: one layer below their sources.
+    for h in n..nx {
+        let mut l = 0;
+        for a in 0..n {
+            if adj[a].iter().any(|&(t, ei)| t == h && !back[ei]) {
+                l = l.max(layer[a] + 1);
+            }
+        }
+        layer[h] = l;
+    }
+    if std::env::var("FMB12_DUMP").is_ok() {
+        let mut by: std::collections::BTreeMap<usize, Vec<&str>> = Default::default();
+        for v in 0..n {
+            by.entry(layer[v]).or_default().push(&g.nodes[v].id);
+        }
+        for (l, ids) in by {
+            eprintln!("B12 layer {l}: {}", ids.join(" "));
+        }
+        for (li, (a, b, _)) in links.iter().enumerate() {
+            if turned[li] {
+                eprintln!("B12 turned: {} -> {}", g.nodes[*a].id, g.nodes[*b].id);
+            }
+        }
+    }
+}
