+/// B12 prototype switch: block ranking is on unless `FMB12=0`.
+pub(crate) fn b12_on() -> bool {
+    std::env::var("FMB12").map_or(true, |v| v != "0")
+}
+
+/// B12 prototype option `name` (`FMB12_<name>=1`).
+pub(crate) fn b12_opt(name: &str) -> bool {
+    std::env::var(format!("FMB12_{name}")).map_or(false, |v| v == "1")
+}
