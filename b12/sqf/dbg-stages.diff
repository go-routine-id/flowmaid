+fn dbg_stage(sc: &Scene, name: &str) {
+    if let Ok(want) = std::env::var("FMDBG_EDGE") {
+        for e in &sc.edges {
+            if format!("{}->{}", e.from, e.to) == want {
+                let w: Vec<String> = e.waypoints.iter().map(|p| format!("({:.2},{:.2})", p.0, p.1)).collect();
+                eprintln!("STAGE {name}: bez0 ({:.2},{:.2}) bez3 ({:.2},{:.2}) wps {}", e.bezier[0].0, e.bezier[0].1, e.bezier[3].0, e.bezier[3].1, w.join(" "));
+            }
+        }
+    }
+}
