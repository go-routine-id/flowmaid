+/// What a block layout's `route()` tells the stages besides the scene
+/// (B12 R1-R3): it draws with the block layout's frames, so the stages
+/// shape its edges by the static scene's block rules ([`Ctx::blocks`]).
+/// Index-parallel with `sc.edges`; missing entries are `false`.
+pub(crate) struct RoutedBlocks {
+    /// The edges drawn in a back-edge lane ([`Ctx::lane`]).
+    pub lanes: Vec<bool>,
+    /// The edges drawn down corridor columns ([`Ctx::corridor`]).
+    pub corridors: Vec<bool>,
+}
+
+/// [`finish_held`] for a block layout's `route()` or `route_partial()`
+/// (`rb`): its lanes and corridors as the builder drew them, and the
+/// stages' block rules on, as in the static scene.
+pub(crate) fn finish_routed_blocks(
+    g: &Graph,
+    sc: &mut Scene,
+    fixed: &[bool],
+    held: &[bool],
+    rb: &RoutedBlocks,
+) {
+    let mut cx = ctx(g, sc);
+    for (f, &x) in cx.fixed.iter_mut().zip(fixed) {
+        *f = x;
+    }
+    for (f, &x) in cx.held.iter_mut().zip(held) {
+        *f = x;
+    }
+    cx.blocks = std::env::var("FMX_NOCXB").is_err();
+    for (i, l) in cx.lane.iter_mut().enumerate() {
+        *l = rb.lanes.get(i).copied().unwrap_or(false);
+    }
+    for (i, c) in cx.corridor.iter_mut().enumerate() {
+        *c = rb.corridors.get(i).copied().unwrap_or(false);
+    }
+    stages(g, sc, cx, Mode::Routed);
+}
