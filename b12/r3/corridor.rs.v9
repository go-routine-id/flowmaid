//! B12 R2 and R3: the classes and corridors of a block layout's
//! [`crate::scene::route`] (and of every drag frame of it).
//!
//! The static scene of a block layout runs a long edge down the dummy
//! chain its layout placed: one column per layer it passes, beside the
//! blocks of the bands between its ends, in through the flow-facing
//! side of every frame round its target. `route()` has no layout, only
//! the host's boxes; drawn as one step from its ports, such an edge ran
//! across the blocks between its ends and the router took it round
//! them afterwards, as it could (the corridor spike of B12.2 measured
//! the lateral frame crossings and the searches it costs).
//!
//! Here each such edge gets the columns a chain would hold, read off
//! the current boxes: per row of boxes it passes (a layer, in the scene
//! at its own centres) one breadth clear of every box in the row and of
//! every frame that holds neither of its ends, inside every frame that
//! holds one of them (its inner legs), the nearest such breadth to the
//! column it comes from (R5). The corridors that share a column are
//! then dealt slots a [`crate::ortho::TRACK_PITCH`] apart, in the order
//! that keeps them from crossing (R3). The ortho stage runs the edge
//! down those columns as it runs a static chain, so the stages after it
//! shape `route()`'s drawing as they shape the static one.
//!
//! An edge needs no corridor where its ends' boxes overlap along the
//! flow (the builders' sides, as before), where both ends are plain
//! nodes of one level (a lane or a curve, as before), where no row of
//! boxes lies between its ends (one step across their gap), or where a
//! straight run down its source's or its target's column passes every
//! row between them (one step, placed by the ortho stage).

use crate::model::{Direction, EdgeKind, Graph};
use crate::scene::SceneNode;

type Pt = (f64, f64);
/// A box in flow coordinates: (breadth lo, breadth hi, flow lo, flow
/// hi), the flow running towards larger values.
type FlowBox = (f64, f64, f64, f64);

/// Room (px) a corridor's column keeps from a box or a frame's border
/// it runs past: what the ortho stage keeps a straightened chain column
/// from them ([`crate::ortho::COLUMN_CLEAR`]).
const CLEAR: f64 = crate::ortho::COLUMN_CLEAR;
/// Float tolerance.
const EPS: f64 = 1e-6;

/// A point in flow coordinates.
fn to_flow(dir: Direction, p: Pt) -> Pt {
    match dir {
        Direction::TD => p,
        Direction::BT => (p.0, -p.1),
        Direction::LR => (p.1, p.0),
        Direction::RL => (p.1, -p.0),
    }
}

/// Inverse of [`to_flow`].
fn from_flow(dir: Direction, p: Pt) -> Pt {
    match dir {
        Direction::TD => p,
        Direction::BT => (p.0, -p.1),
        Direction::LR => (p.1, p.0),
        Direction::RL => (-p.1, p.0),
    }
}

/// A screen rect `(x0, y0, x1, y1)` in flow coordinates.
fn flow_box(dir: Direction, r: (f64, f64, f64, f64)) -> FlowBox {
    let (a, b) = (to_flow(dir, (r.0, r.1)), to_flow(dir, (r.2, r.3)));
    (a.0.min(b.0), a.0.max(b.0), a.1.min(b.1), a.1.max(b.1))
}

/// One edge's corridor: its columns (flow coordinates, one per row of
/// boxes it passes, in the order it passes them), the breadth it leaves
/// its source towards and enters its target from, and its label's spot.
#[derive(Clone, Debug)]
pub(crate) struct Corridor {
    /// Screen points: the source's port on its flow-facing side, one
    /// point per row passed, the target's port.
    pub(crate) waypoints: Vec<Pt>,
    /// Where its label goes (screen): on its leg between its two end
    /// units (R8).
    pub(crate) label: Pt,
}

/// The rows of boxes along the flow (merged flow intervals of `boxes`).
fn rows_of(boxes: &[FlowBox]) -> Vec<(f64, f64)> {
    let mut rows: Vec<(f64, f64)> = boxes
        .iter()
        .map(|r| (r.2, r.3))
        .filter(|r| r.0.is_finite() && r.1.is_finite())
        .collect();
    rows.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.total_cmp(&b.1)));
    let mut merged: Vec<(f64, f64)> = Vec::with_capacity(rows.len());
    for r in rows {
        match merged.last_mut() {
            Some(m) if r.0 <= m.1 => m.1 = m.1.max(r.1),
            _ => merged.push(r),
        }
    }
    merged
}

/// `span` with `cut` (a closed interval) taken out of every interval.
fn subtract(span: &mut Vec<(f64, f64)>, cut: (f64, f64)) {
    let mut out = Vec::with_capacity(span.len() + 1);
    for &(a, b) in span.iter() {
        if cut.1 <= a || cut.0 >= b {
            out.push((a, b));
            continue;
        }
        if cut.0 > a {
            out.push((a, cut.0));
        }
        if cut.1 < b {
            out.push((cut.1, b));
        }
    }
    *span = out;
}

/// `span` clipped to `keep`.
fn clip(span: &mut Vec<(f64, f64)>, keep: (f64, f64)) {
    *span = span
        .iter()
        .filter_map(|&(a, b)| {
            let (a, b) = (a.max(keep.0), b.min(keep.1));
            (b >= a).then_some((a, b))
        })
        .collect();
}

/// The point of `span` nearest `x` (the lower one on a tie, R5), with
/// the interval it lies in.
fn nearest(span: &[(f64, f64)], x: f64) -> Option<(f64, (f64, f64))> {
    let mut best: Option<(f64, f64, (f64, f64))> = None;
    for &(a, b) in span {
        let p = x.clamp(a, b);
        let d = (p - x).abs();
        if best.map_or(true, |(bd, bp, _)| d < bd - EPS || (d <= bd + EPS && p < bp)) {
            best = Some((d, p, (a, b)));
        }
    }
    best.map(|(_, p, i)| (p, i))
}

/// Whether `x` lies in `span`.
fn holds(span: &[(f64, f64)], x: f64) -> bool {
    span.iter().any(|&(a, b)| x >= a - EPS && x <= b + EPS)
}

/// One planned corridor, in flow coordinates, before its slots.
struct Planned {
    edge: usize,
    /// Heading along the flow: +1 downstream, -1 upstream.
    h: f64,
    /// The source's and the target's ports (breadth, flow).
    p0: Pt,
    p3: Pt,
    /// Per row passed: its column, its flow span and the free interval
    /// of the row the column lies in.
    cols: Vec<(f64, (f64, f64), (f64, f64))>,
    /// The flow span between its two end units (where its label goes).
    between: (f64, f64),
}

/// One straight run of a corridor: columns `k0..k1` of corridor `pi`
/// at one breadth.
struct Run {
    pi: usize,
    k0: usize,
    k1: usize,
    at: f64,
    /// Its flow span (low, high).
    span: (f64, f64),
    /// The free interval it may move in (every row's, intersected).
    room: (f64, f64),
    /// The breadth it comes from (the run before, or the source's
    /// port) and goes to (the run after, or the target's port).
    from: f64,
    to: f64,
    /// Where it ends along its own heading (larger = later).
    leaves: f64,
}

/// What the corridors of one `route()` call are read off: the boxes in
/// flow coordinates and each edge's class (R2).
pub(crate) struct Corridors {
    dir: Direction,
    boxes: Vec<FlowBox>,
    fboxes: Vec<Option<FlowBox>>,
    rows: Vec<(f64, f64)>,
    /// Per edge of `g.edges`: its heading (+1 downstream, -1 upstream)
    /// and the boxes of the two units it joins at its ends' common
    /// level, when those units are not two plain nodes and lie apart
    /// along the flow by [`crate::scene::FLOW_MIN_GAP`] (E1-E3); `None`
    /// for an edge drawn by the builders as before.
    class: Vec<Option<(f64, FlowBox, FlowBox)>>,
}

impl Corridors {
    /// R2 for `g` drawn with `nodes` (the scene's boxes) and `frames`
    /// (each subgraph's frame before any edge, F1 and F2, screen `(x, y,
    /// w, h)`); `paths` is each node's subgraph path (outermost first).
    pub(crate) fn new(
        g: &Graph,
        nodes: &[SceneNode],
        frames: &[Option<(f64, f64, f64, f64)>],
        paths: &[Vec<usize>],
    ) -> Corridors {
        let dir = g.direction;
        let boxes: Vec<FlowBox> = nodes
            .iter()
            .map(|n| {
                flow_box(
                    dir,
                    (
                        n.x - n.w / 2.0,
                        n.y - n.h / 2.0,
                        n.x + n.w / 2.0,
                        n.y + n.h / 2.0,
                    ),
                )
            })
            .collect();
        let fboxes: Vec<Option<FlowBox>> = frames
            .iter()
            .map(|f| f.map(|(x, y, w, h)| flow_box(dir, (x, y, x + w, y + h))))
            .collect();
        let rows = rows_of(&boxes);
        let tree = crate::levels::Tree::new(paths, g.subgraphs.len());
        let card = |v: usize| {
            let n = &g.nodes[v];
            crate::style::is_note_card(&n.id, n.shape, &n.style)
        };
        let unit_box = |u: crate::levels::Unit| -> Option<FlowBox> {
            match u {
                crate::levels::Unit::Node(v) => Some(boxes[v]),
                crate::levels::Unit::Block(s) => fboxes.get(s).copied().flatten(),
            }
        };
        let class = g
            .edges
            .iter()
            .map(|e| {
                let (u, v) = (e.from, e.to);
                if u == v
                    || matches!(e.kind, EdgeKind::Invisible)
                    || card(u)
                    || card(v)
                    || e.meta.curve.is_some()
                {
                    return None;
                }
                let (_, cu, cv) = tree.join(u, v);
                if cu == cv
                    || matches!(
                        (cu, cv),
                        (crate::levels::Unit::Node(_), crate::levels::Unit::Node(_))
                    )
                {
                    return None;
                }
                let (s, t) = (unit_box(cu)?, unit_box(cv)?);
                let gap = crate::scene::FLOW_MIN_GAP;
                if t.2 >= s.3 + gap {
                    Some((1.0, s, t))
                } else if s.2 >= t.3 + gap {
                    Some((-1.0, s, t))
                } else {
                    None
                }
            })
            .collect();
        Corridors {
            dir,
            boxes,
            fboxes,
            rows,
            class,
        }
    }

    /// Whether edge `ei` runs against the flow between two units of
    /// which one at least is a block (E3): in a block layout it is no
    /// back-edge lane but a channel through flow-facing sides, as the
    /// static scene draws it.
    pub(crate) fn upstream(&self, ei: usize) -> bool {
        matches!(self.class.get(ei), Some(Some((h, _, _))) if *h < 0.0)
    }

    /// The builder's curve of class edge `ei` from `u` to `v` (screen):
    /// out of the source's flow-facing side, into the target's, each at
    /// its box's middle, square to both sides — an upstream one leaves
    /// its source's upstream side and enters its target's downstream
    /// side (E3), where a plain back-edge's curve bows round to the
    /// sides a lane takes. `None` for an edge with no class.
    pub(crate) fn facing(&self, ei: usize, (u, v): (usize, usize)) -> Option<[Pt; 4]> {
        let (h, _, _) = self.class.get(ei).copied().flatten()?;
        let (bu, bv) = (self.boxes[u], self.boxes[v]);
        let (l0, l3) = if h > 0.0 { (bu.3, bv.2) } else { (bu.2, bv.3) };
        let (b0, b3) = ((bu.0 + bu.1) / 2.0, (bv.0 + bv.1) / 2.0);
        let m = (l0 + l3) / 2.0;
        Some([(b0, l0), (b0, m), (b3, m), (b3, l3)].map(|p| from_flow(self.dir, p)))
    }

    /// The corridors, index-parallel with `g.edges` (`None` for an edge
    /// drawn as before); `skip` holds the edges drawn otherwise (a lane,
    /// a twin's bow).
    pub(crate) fn plan(&self, g: &Graph, paths: &[Vec<usize>], skip: &[bool]) -> Vec<Option<Corridor>> {
        let mut planned: Vec<Planned> = Vec::new();
        for (ei, e) in g.edges.iter().enumerate() {
            if skip.get(ei).copied().unwrap_or(false) {
                continue;
            }
            let Some(Some((h, s, t))) = self.class.get(ei).copied() else {
                continue;
            };
            if let Some(p) = corridor(
                &self.boxes,
                &self.fboxes,
                &self.rows,
                paths,
                (e.from, e.to),
                h,
                (s, t),
            ) {
                planned.push(Planned { edge: ei, ..p });
            }
        }
        slot(&mut planned);
        let dir = self.dir;
        let mut out: Vec<Option<Corridor>> = vec![None; g.edges.len()];
        for p in planned {
            let cols: Vec<Pt> = p.cols.iter().map(|c| (c.0, (c.1 .0 + c.1 .1) / 2.0)).collect();
            // R8: the label on the leg between the two end units, outside
            // both: the middle column there, else the middle of the gap
            // between them on the column the edge runs down there.
            let (glo, ghi) = p.between;
            let inner: Vec<Pt> = cols.iter().copied().filter(|c| c.1 > glo && c.1 < ghi).collect();
            let label = match inner.get(inner.len() / 2) {
                Some(&c) => c,
                None => {
                    let mid = (glo + ghi) / 2.0;
                    let col = cols
                        .iter()
                        .rev()
                        .find(|c| (c.1 - mid) * p.h <= 0.0)
                        .map_or(p.p0.0, |c| c.0);
                    (col, mid)
                }
            };
            let waypoints = std::iter::once(p.p0)
                .chain(cols)
                .chain(std::iter::once(p.p3))
                .map(|q| from_flow(dir, q))
                .collect();
            out[p.edge] = Some(Corridor {
                waypoints,
                label: from_flow(dir, label),
            });
        }
        out
    }
}

/// R3's slots: the runs of different corridors that would share a
/// column along a stretch of the flow are spread a
/// [`crate::ortho::TRACK_PITCH`] apart inside the free interval they
/// share, in the order that keeps them from crossing: of those leaving
/// to one side, the one leaving first lies nearest that side (a later
/// one turns off behind it); at one place, the one going farther lies
/// outside; one running on to the target's column keeps the order it
/// came in. Edge index breaks ties, never statement order alone.
fn slot(planned: &mut [Planned]) {
    let pitch = crate::ortho::TRACK_PITCH;
    let mut runs: Vec<Run> = Vec::new();
    for (pi, p) in planned.iter().enumerate() {
        let n = p.cols.len();
        let mut k0 = 0;
        while k0 < n {
            let at = p.cols[k0].0;
            let mut k1 = k0 + 1;
            while k1 < n && (p.cols[k1].0 - at).abs() < EPS {
                k1 += 1;
            }
            let span = p.cols[k0..k1]
                .iter()
                .fold((f64::INFINITY, f64::NEG_INFINITY), |a, c| {
                    (a.0.min(c.1 .0), a.1.max(c.1 .1))
                });
            let room = p.cols[k0..k1]
                .iter()
                .fold((f64::NEG_INFINITY, f64::INFINITY), |a, c| {
                    (a.0.max(c.2 .0), a.1.min(c.2 .1))
                });
            let from = if k0 == 0 { p.p0.0 } else { p.cols[k0 - 1].0 };
            let to = if k1 == n { p.p3.0 } else { p.cols[k1].0 };
            let end = if p.h > 0.0 { span.1 } else { span.0 };
            runs.push(Run {
                pi,
                k0,
                k1,
                at,
                span,
                room,
                from,
                to,
                leaves: p.h * end,
            });
            k0 = k1;
        }
    }
    // Groups: runs of different corridors closer than a pitch over a
    // shared stretch of the flow.
    let nr = runs.len();
    let mut root: Vec<usize> = (0..nr).collect();
    fn find(root: &mut [usize], mut a: usize) -> usize {
        while root[a] != a {
            root[a] = root[root[a]];
            a = root[a];
        }
        a
    }
    for i in 0..nr {
        for j in i + 1..nr {
            let (a, b) = (&runs[i], &runs[j]);
            if a.pi == b.pi
                || (a.at - b.at).abs() >= pitch - EPS
                || a.span.1.min(b.span.1) - a.span.0.max(b.span.0) <= EPS
            {
                continue;
            }
            let (ri, rj) = (find(&mut root, i), find(&mut root, j));
            if ri != rj {
                root[ri.max(rj)] = ri.min(rj);
            }
        }
    }
    let mut groups: std::collections::BTreeMap<usize, Vec<usize>> = Default::default();
    for i in 0..nr {
        let r = find(&mut root, i);
        groups.entry(r).or_default().push(i);
    }
    for (_, mut members) in groups {
        if members.len() < 2 {
            continue;
        }
        // The side each leaves to, then the order R3 asks for.
        let side = |r: &Run| {
            if r.to > r.at + EPS {
                1
            } else if r.to < r.at - EPS {
                -1
            } else {
                0
            }
        };
        members.sort_by(|&x, &y| {
            let (a, b) = (&runs[x], &runs[y]);
            let (sa, sb) = (side(a), side(b));
            sa.cmp(&sb)
                .then_with(|| match sa {
                    1 => b.leaves.total_cmp(&a.leaves).then(a.to.total_cmp(&b.to)),
                    -1 => a.leaves.total_cmp(&b.leaves).then(a.to.total_cmp(&b.to)),
                    _ => a.from.total_cmp(&b.from),
                })
                .then(planned[a.pi].edge.cmp(&planned[b.pi].edge))
        });
        let room = members.iter().fold((f64::NEG_INFINITY, f64::INFINITY), |acc, &m| {
            (acc.0.max(runs[m].room.0), acc.1.min(runs[m].room.1))
        });
        let mean = members.iter().map(|&m| runs[m].at).sum::<f64>() / members.len() as f64;
        let (lo, hi) = if room.0 <= room.1 { room } else { (mean, mean) };
        let k = members.len();
        let width = hi - lo;
        let step = if width.is_finite() && width < pitch * (k - 1) as f64 {
            (width / (k - 1) as f64).max(crate::clearance::EDGE_SPACING)
        } else {
            pitch
        };
        let want: Vec<f64> = members.iter().map(|&m| runs[m].at).collect();
        let at = crate::ports::place(&want, step, lo, hi.max(lo + step * (k - 1) as f64));
        for (&m, x) in members.iter().zip(at) {
            let r = &runs[m];
            for c in &mut planned[r.pi].cols[r.k0..r.k1] {
                c.0 = x;
            }
        }
    }
}

/// The corridor of the edge `u -> v` heading `h` along the flow (+1
/// downstream, -1 upstream) between its end units' boxes `s` and `t`,
/// or `None` when it needs none (see the module docs).
fn corridor(
    boxes: &[FlowBox],
    fboxes: &[Option<FlowBox>],
    rows: &[(f64, f64)],
    paths: &[Vec<usize>],
    (u, v): (usize, usize),
    h: f64,
    (s, t): (FlowBox, FlowBox),
) -> Option<Planned> {
    let (bu, bv) = (boxes[u], boxes[v]);
    // The flow-facing sides the edge leaves and enters by.
    let (from_l, to_l) = if h > 0.0 { (bu.3, bv.2) } else { (bu.2, bv.3) };
    let (lo, hi) = (from_l.min(to_l), from_l.max(to_l));
    let mut passed: Vec<(f64, f64)> = rows
        .iter()
        .copied()
        .filter(|r| r.0 >= lo - EPS && r.1 <= hi + EPS)
        .collect();
    if h < 0.0 {
        passed.reverse();
    }
    if passed.is_empty() {
        return None;
    }
    let inside = |si: usize| paths[u].contains(&si) || paths[v].contains(&si);
    // Per row: where a column may run.
    let allowed: Vec<Vec<(f64, f64)>> = passed
        .iter()
        .map(|&(r0, r1)| {
            let meets = |b: &FlowBox| b.3 > r0 + EPS && b.2 < r1 - EPS;
            let mut span = vec![(f64::NEG_INFINITY, f64::INFINITY)];
            for (si, f) in fboxes.iter().enumerate() {
                let Some(f) = f else { continue };
                if !meets(f) {
                    continue;
                }
                if inside(si) {
                    clip(&mut span, (f.0 + CLEAR, f.1 - CLEAR));
                } else {
                    subtract(&mut span, (f.0 - CLEAR, f.1 + CLEAR));
                }
            }
            for (w, b) in boxes.iter().enumerate() {
                if w != u && w != v && meets(b) {
                    subtract(&mut span, (b.0 - CLEAR, b.1 + CLEAR));
                }
            }
            span
        })
        .collect();
    let (from_b, to_b) = ((bu.0 + bu.1) / 2.0, (bv.0 + bv.1) / 2.0);
    // A straight run down the source's or the target's column clear of
    // every row: one step, which the ortho stage places.
    if allowed.iter().all(|a| holds(a, from_b)) || allowed.iter().all(|a| holds(a, to_b)) {
        return None;
    }
    let mut cols = Vec::with_capacity(passed.len());
    let mut cur = from_b;
    for (k, a) in allowed.iter().enumerate() {
        let room = if holds(a, cur) {
            a.iter()
                .copied()
                .find(|&(x, y)| cur >= x - EPS && cur <= y + EPS)
                .unwrap_or((cur, cur))
        } else {
            let (p, r) = nearest(a, cur)?;
            cur = p;
            r
        };
        cols.push((cur, passed[k], room));
    }
    // The ports on the flow-facing sides, towards the first and last
    // column.
    let inset = crate::ports::PORT_INSET;
    let port = |b: &FlowBox, at: f64, l: f64| {
        let (a, z) = (b.0 + inset, b.1 - inset);
        let x = if a <= z { at.clamp(a, z) } else { (b.0 + b.1) / 2.0 };
        (x, l)
    };
    let p0 = port(&bu, cols[0].0, from_l);
    let p3 = port(&bv, cols[cols.len() - 1].0, to_l);
    let between = if h > 0.0 { (s.3, t.2) } else { (t.3, s.2) };
    Some(Planned {
        edge: usize::MAX,
        h,
        p0,
        p3,
        cols,
        between,
    })
}
