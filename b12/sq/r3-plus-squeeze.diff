+#[test]
+fn a_block_is_squeezed_to_its_content() {
+    // X2: a block whose Brandes-Köpf breadth is wider than its members
+    // need is squeezed to its least breadth. The public fixture's frames
+    // were up to 25 times the area of their members (the observability
+    // block spread across the drawing beside the alert rules' pin); the
+    // must of its row is mermaid's 6.64 + 20 %, in every permutation and
+    // in BT.
+    for name in [
+        "blocks/blocks-overview",
+        "blocks/blocks-overview-bt",
+        "blocks/blocks-overview-edges-reversed",
+        "blocks/blocks-overview-edges-rotated",
+        "blocks/blocks-overview-actors-reversed",
+        "blocks/blocks-overview-subgraphs-reversed",
+    ] {
+        let g = fixture(name);
+        let sc = block_scene(&g);
+        let q = crate::quality::measure(&g, &sc);
+        assert!(q.compact_max <= 7.97, "{name}: compact_max {}", q.compact_max);
+        assert_eq!((q.frame_overlap, q.node_frame), (0, 0), "{name}");
+    }
+}
+
+#[test]
+fn a_spine_inside_a_block_is_straight() {
+    // X2.4: a spine (two members each other's only inner link in that
+    // direction) is one rigid column through the squeeze: the build
+    // pipeline's three steps stand in one column, and no spine of the
+    // fixtures the spec names is drawn bent.
+    let g = fixture("blocks/blocks-overview");
+    let sc = block_scene(&g);
+    let xs: Vec<f64> = ["REPO", "BUILD", "REG"]
+        .iter()
+        .map(|id| {
+            let b = node_box(&sc, id);
+            (b.0 + b.2) / 2.0
+        })
+        .collect();
+    assert!(
+        (xs[0] - xs[1]).abs() < 0.5 && (xs[1] - xs[2]).abs() < 0.5,
+        "{xs:?}"
+    );
+    for name in [
+        "blocks/blocks-overview",
+        "blocks/hub5",
+        "notes/spread-face",
+        "notes/nested-composite",
+        "notes/fork-twins",
+    ] {
+        let g = fixture(name);
+        let sc = block_scene(&g);
+        let q = crate::quality::measure(&g, &sc);
+        assert_eq!(q.spine_off, 0, "{name}");
+    }
+}
