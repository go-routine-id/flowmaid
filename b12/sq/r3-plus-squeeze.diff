+}
+
+/// Whether the path `pts` (edge-local corners) runs into one of
+/// `obstacles` (edge-local boxes): a leg along the flow nearer than
+/// [`LANE_PAD`] to a box's side, a leg across it nearer than a corner's
+/// half rounding to its end.
+fn corridor_hits(pts: &[(f64, f64)], obstacles: &[(f64, f64, f64, f64)]) -> bool {
+    const EPS: f64 = 1e-6;
+    let pad_l = crate::router::CORNER_R / 2.0;
+    pts.windows(2).any(|w| {
+        let (p, q) = (w[0], w[1]);
+        obstacles.iter().any(|o| {
+            if (p.0 - q.0).abs() < EPS {
+                let (a, b) = (p.1.min(q.1), p.1.max(q.1));
+                p.0 > o.0 - LANE_PAD + EPS && p.0 < o.1 + LANE_PAD - EPS && b > o.2 && a < o.3
+            } else {
+                let (a, b) = (p.0.min(q.0), p.0.max(q.0));
+                p.1 > o.2 - pad_l && p.1 < o.3 + pad_l && b > o.0 && a < o.1
+            }
+        })
+    })
+}
