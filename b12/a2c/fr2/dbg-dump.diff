 /// The edge stages over `sc` with its context built.
+fn dbg_dump(sc: &Scene, stage: &str) {
+    if let Ok(w) = std::env::var("FMDBG_EDGE") {
+        for e in &sc.edges {
+            let k = format!("{}->{}", e.from, e.to);
+            if w.split(',').any(|x| x == k) {
+                let p: Vec<String> = e.waypoints.iter().map(|p| format!("({:.1},{:.1})", p.0, p.1)).collect();
+                eprintln!("[{stage}] {k}: {}", p.join(" "));
+            }
+        }
+    }
+}
