+/// How many ends of edges to or from the whole of subgraph `i` cross
+/// its title side (TD: the other end lies above the members, `top`;
+/// BT: below them, `bottom`), as the layout counts them
+/// (`layout::title_side_pins`).
+fn title_side_pins(g: &Graph, nodes: &[SceneNode], i: usize, top: f64, bottom: f64) -> usize {
+    let bt = matches!(g.direction, Direction::BT);
+    let inside = |j: usize| -> Vec<usize> {
+        (0..g.subgraphs.len())
+            .filter(|&s| {
+                let mut p = Some(s);
+                while let Some(q) = p {
+                    if q == j {
+                        return true;
+                    }
+                    p = g.subgraphs[q].parent;
+                }
+                false
+            })
+            .flat_map(|s| g.subgraphs[s].nodes.iter().copied())
+            .collect()
+    };
+    let at = |e: &End| -> Option<f64> {
+        match *e {
+            End::Node(v) => nodes.get(v).map(|n| n.y),
+            End::Sub(j) => {
+                let vs = inside(j);
+                (!vs.is_empty()).then(|| vs.iter().map(|&v| nodes[v].y).sum::<f64>() / vs.len() as f64)
+            }
+        }
+    };
+    let mut k = 0;
+    for se in &g.sub_edges {
+        for (mine, other) in [(&se.to, &se.from), (&se.from, &se.to)] {
+            if *mine != End::Sub(i) || *other == End::Sub(i) {
+                continue;
+            }
+            if let Some(y) = at(other) {
+                if (!bt && y < top) || (bt && y > bottom) {
+                    k += 1;
+                }
+            }
+        }
+    }
+    k
+}
