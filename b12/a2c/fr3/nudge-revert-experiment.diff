+/// The least distance (px) between polylines `a` and `b`.
+fn poly_gap(a: &[Pt], b: &[Pt]) -> f64 {
+    a.windows(2)
+        .flat_map(|s| {
+            b.windows(2)
+                .map(move |t| seg_seg_dist(s[0], s[1], t[0], t[1]))
+        })
+        .fold(f64::INFINITY, f64::min)
+}
