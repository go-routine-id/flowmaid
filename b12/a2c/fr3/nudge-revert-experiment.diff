+    dbg_dump(sc, "comb");
     glyph_stubs(sc, &cx, &mut moved);
     straight_cubics(sc, &cx);
     square_s_cubics(sc, &cx);
     snap_ends(sc, &cx);
+    dbg_dump(sc, "snap");
     // A corner a moved end left far from its rounding point turns as a
