+#[test]
+fn a_nudged_entry_does_not_land_on_a_pin_whose_move_was_refused() {
+    // The channel nudge spreads a group's legs together, a stroke
+    // spacing apart, and then judges each edge's move on its own. An
+    // entry rerouted past its frame's title chip and the frame's pin
+    // from the same node were spread together; the pin's move was
+    // refused and the entry's kept, 1 px beside the pin, the two heads
+    // into the frame one on the other. In a block layout drawn TD / BT
+    // such a move goes back where it was.
+    let src = "flowchart TD
+    subgraph A[Shipping and returns desk]
+        a0[a0]
+        a1[a1 wide node]
+        a2[a2 wide node]
+    end
+    subgraph B[Shipping and returns desk two]
+        b0[b0 wide node]
+        b1[b1]
+    end
+    a0 -- \"x\" --> b0
+    a1 --> b0
+    a1 --> b1
+    p[p] --> B
+    q[q] --> B
+    q --> b0";
+    let rep = crate::levels::with_blocks(true, || crate::quality::measure_source(src, false))
+        .expect("a flowchart");
+    assert!(rep.block_mode);
+    let m = &rep.statik;
+    assert_eq!(m.overlap_pairs, 0, "{:?}", m.details);
+}
