#!/usr/bin/env python3
"""show - print blockmetrics TSV files as an aligned table, optionally transposed.

  show [-t] file.tsv [file.tsv ...]      -t = one column per row (easier for one diagram)
"""
import sys
args = sys.argv[1:]
t = '-t' in args
files = [a for a in args if a != '-t'] or ['/dev/stdin']
rows, head = [], None
for f in files:
    for i, line in enumerate(open(f)):
        cells = line.rstrip('\n').split('\t')
        if cells and cells[0] == 'name':
            if head is None:
                head = cells
            continue
        if line.strip():
            rows.append(cells)
if head is None:
    sys.exit('no header row')
if t:
    w0 = max(len(h) for h in head)
    cols = [[f"{r[0]}/{r[1]}"] + r[2:] for r in rows]
    ws = [max(len(c) for c in col) for col in cols]
    print(' ' * w0 + '  ' + '  '.join(col[0].rjust(ws[k]) for k, col in enumerate(cols)))
    for i, h in enumerate(head[2:], start=1):
        print(h.ljust(w0) + '  ' + '  '.join((col[i] if i < len(col) else '').rjust(ws[k]) for k, col in enumerate(cols)))
else:
    table = [head] + rows
    ws = [max(len(r[i]) if i < len(r) else 0 for r in table) for i in range(len(head))]
    for r in table:
        print('  '.join((r[i] if i < len(r) else '').ljust(ws[i]) for i in range(len(head))).rstrip())
