+fn level_sibling_frames(
+    g: &Graph,
+    nc: &[Vec<usize>],
+    alayer: &[usize],
+    alsize: &[f64],
+    lcoord: &[f64],
+    cluster_span: &BTreeMap<usize, (usize, usize)>,
+    header: &[f64],
+    title_jog: &[f64],
+    flow_short: &[f64],
+) -> Vec<f64> {
+    let n = g.nodes.len();
+    let mut lpos: Vec<f64> = (0..n).map(|v| lcoord[alayer[v]]).collect();
+    let strip_lo = matches!(g.direction, Direction::TD);
+    let strip_hi = matches!(g.direction, Direction::BT);
+    // What frame `c` reaches past a member on its first (`hi` false)
+    // or last row.
+    let grow = |c: usize, hi: bool| -> f64 {
+        let strip = if hi { strip_hi } else { strip_lo };
+        FRAME_PAD
+            + flow_short.get(c).copied().unwrap_or(0.0) / 2.0
+            + if strip {
+                header[c] + title_jog.get(c).copied().unwrap_or(0.0)
+            } else {
+                0.0
+            }
+    };
