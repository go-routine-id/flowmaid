+    // or last row.
+    let grow = |c: usize, hi: bool| -> f64 {
+        let strip = if hi { strip_hi } else { strip_lo };
+        FRAME_PAD
+            + flow_short.get(c).copied().unwrap_or(0.0) / 2.0
+            + if strip {
+                header[c] + title_jog.get(c).copied().unwrap_or(0.0)
