+    g: &Graph,
+    nc: &[Vec<usize>],
+    alayer: &[usize],
+    alsize: &[f64],
+    lcoord: &[f64],
+    cluster_span: &BTreeMap<usize, (usize, usize)>,
+    header: &[f64],
+    title_jog: &[f64],
+    flow_short: &[f64],
