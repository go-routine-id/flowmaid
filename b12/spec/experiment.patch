+/// SPEC EXPERIMENT: level-first ordering of the root level. Every
+/// top-level block is one unit per layer, every free node or dummy its
+/// own; links are collapsed to unit pairs with their multiplicity, and a
+/// block is tied to itself across its layers by a heavy link. Weighted
+/// barycentre sweeps + adjacent exchanges from a few starts; the order
+/// with the least weighted crossings comes back as per-layer keys.
+type LvlKeys = Vec<std::collections::BTreeMap<(u8, usize), f64>>;
+fn level_order(
+    layers: &[Vec<usize>],
+    succs: &[Vec<usize>],
+    alayer: &[usize],
+    apath: &[Vec<usize>],
+    nlayers: usize,
+) -> LvlKeys {
+    use std::collections::BTreeMap;
+    type U = (u8, usize);
+    const TIE: f64 = 1000.0;
+    let unit = |v: usize| -> U {
+        if apath[v].is_empty() {
+            (1, v)
+        } else {
+            (0, apath[v][0])
+        }
+    };
+    let mut lu: Vec<Vec<U>> = Vec::with_capacity(nlayers);
+    for lv in layers {
+        let mut us: Vec<U> = Vec::new();
+        for &v in lv {
+            let u = unit(v);
+            if !us.contains(&u) {
+                us.push(u);
+            }
+        }
+        lu.push(us);
+    }
+    let mut gaps: Vec<Vec<(U, U, f64)>> = Vec::new();
+    for li in 0..nlayers.saturating_sub(1) {
+        let mut w: BTreeMap<(U, U), f64> = BTreeMap::new();
+        for &u in &layers[li] {
+            for &v in &succs[u] {
+                if alayer[v] == li + 1 {
+                    let (a, b) = (unit(u), unit(v));
+                    if a != b {
+                        *w.entry((a, b)).or_insert(0.0) += 1.0;
+                    }
+                }
+            }
+        }
+        for &u in &lu[li] {
+            if u.0 == 0 && lu[li + 1].contains(&u) {
+                w.insert((u, u), TIE);
+            }
+        }
+        gaps.push(w.into_iter().map(|((a, b), x)| (a, b, x)).collect());
+    }
+    let index = |ord: &[Vec<U>]| -> Vec<BTreeMap<U, usize>> {
+        ord.iter()
+            .map(|l| l.iter().enumerate().map(|(i, &u)| (u, i)).collect())
+            .collect()
+    };
+    let gap_cost = |ord: &[Vec<U>], li: usize| -> f64 {
+        let ix = index(ord);
+        let es: Vec<(usize, usize, f64)> = gaps[li]
+            .iter()
+            .map(|&(a, b, x)| (ix[li][&a], ix[li + 1][&b], x))
+            .collect();
+        let mut c = 0.0;
+        for i in 0..es.len() {
+            for j in (i + 1)..es.len() {
+                let (p, q) = (es[i], es[j]);
+                if (p.0 < q.0 && p.1 > q.1) || (p.0 > q.0 && p.1 < q.1) {
+                    c += p.2 * q.2;
+                }
+            }
+        }
+        c
+    };
+    let cost = |ord: &[Vec<U>]| -> f64 { (0..gaps.len()).map(|li| gap_cost(ord, li)).sum() };
+    let bary = |ord: &mut Vec<Vec<U>>, li: usize, down: bool| {
+        let ix = index(ord);
+        let mut keyed: Vec<(f64, usize, U)> = Vec::new();
+        for (i, &u) in ord[li].iter().enumerate() {
+            let (mut sw, mut sx) = (0.0, 0.0);
+            if down && li > 0 {
+                for &(a, b, x) in &gaps[li - 1] {
+                    if b == u {
+                        sw += x;
+                        sx += x * ix[li - 1][&a] as f64 / ord[li - 1].len().max(1) as f64;
+                    }
+                }
+            }
+            if !down && li + 1 < ord.len() {
+                for &(a, b, x) in &gaps[li] {
+                    if a == u {
+                        sw += x;
+                        sx += x * ix[li + 1][&b] as f64 / ord[li + 1].len().max(1) as f64;
+                    }
+                }
+            }
+            let key = if sw > 0.0 {
+                sx / sw
+            } else {
+                i as f64 / ord[li].len().max(1) as f64
+            };
+            keyed.push((key, i, u));
+        }
+        keyed.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+        ord[li] = keyed.into_iter().map(|k| k.2).collect();
+    };
+    let exchange = |ord: &mut Vec<Vec<U>>| {
+        for _ in 0..10 {
+            let mut any = false;
+            for li in 0..ord.len() {
+                for i in 0..ord[li].len().saturating_sub(1) {
+                    let around = |ord: &Vec<Vec<U>>| -> f64 {
+                        let mut c = 0.0;
+                        if li > 0 {
+                            c += gap_cost(ord, li - 1);
+                        }
+                        if li + 1 < ord.len() {
+                            c += gap_cost(ord, li);
+                        }
+                        c
+                    };
+                    let before = around(ord);
+                    ord[li].swap(i, i + 1);
+                    if around(ord) + 1e-9 < before {
+                        any = true;
+                    } else {
+                        ord[li].swap(i, i + 1);
+                    }
+                }
+            }
+            if !any {
+                break;
+            }
+        }
+    };
+    let mut starts: Vec<Vec<Vec<U>>> = vec![lu.clone()];
+    starts.push(lu.iter().map(|l| l.iter().rev().copied().collect()).collect());
+    let mut best = lu.clone();
+    let mut best_c = f64::INFINITY;
+    for start in starts {
+        let mut ord = start;
+        for _ in 0..12 {
+            for li in 1..ord.len() {
+                bary(&mut ord, li, true);
+            }
+            exchange(&mut ord);
+            let c = cost(&ord);
+            if c + 1e-9 < best_c {
+                best_c = c;
+                best = ord.clone();
+            }
+            for li in (0..ord.len().saturating_sub(1)).rev() {
+                bary(&mut ord, li, false);
+            }
+            exchange(&mut ord);
+            let c = cost(&ord);
+            if c + 1e-9 < best_c {
+                best_c = c;
+                best = ord.clone();
+            }
+        }
+    }
+    if std::env::var("FM_B12_DUMP").is_ok() {
+        eprintln!("B12 LVL: root cost {best_c}");
+    }
+    // Keys: a block's ordinal among the blocks of its layer; a free
+    // node's slot (the number of blocks left of it). The order of the
+    // free nodes inside one slot stays with the flat sweeps.
+    best.iter()
+        .map(|l| {
+            let mut k = 0usize;
+            l.iter()
+                .map(|&u| {
+                    if u.0 == 0 {
+                        k += 1;
+                        (u, (k - 1) as f64 + 0.75)
+                    } else {
+                        (u, k as f64)
+                    }
+                })
+                .collect()
+        })
+        .collect()
+}
+
 /// Ordering keys shared by every layer: per node its normalised in-layer
 /// position `(i + 0.5) / len`, and per cluster the mean of that over all
 /// its non-wall members on ALL layers.
