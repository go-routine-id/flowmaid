+/// edges as lanes), 2 (block layers, reversed inter-block edges in
+/// channels; the default).
+pub(crate) fn b12_mode() -> u8 {
+    match std::env::var("FM_B12").ok().as_deref() {
+        Some("0") => 0,
+        Some("1") => 1,
+        _ => 2,
+    }
