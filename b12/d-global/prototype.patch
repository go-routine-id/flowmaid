+/// B12 prototype: one layer per node from a block-aware layering. Levels
+/// are the root and every subgraph; a level's units are its direct
+/// member nodes and its direct child subgraphs. Per level, deepest
+/// first: collapse every link to the pair of units it joins, break the
+/// cycles of that unit graph (DFS from the sources, units and their
+/// links in declaration order), then longest path where a unit `u` of
+/// height `h(u)` layers pushes its successors `h(u)` layers down. A
+/// source block (and a lead note) sinks to just above its nearest
+/// successor. A node's layer = the starts of its chain of blocks + its
+/// own start.
+fn block_layers(g: &Graph, nc: &[Vec<usize>], rank_only: &[RankGroup]) -> Vec<usize> {
+    let n = g.nodes.len();
+    let ns = g.subgraphs.len();
+    // Unit ids: node v, block n + s. Level ids: 0 root, s + 1.
+    let mut key = vec![usize::MAX; n + ns];
+    let mut parent_level = vec![0usize; ns];
+    let mut depth = vec![0usize; ns];
+    for v in 0..n {
+        key[v] = v;
+        for (i, &s) in nc[v].iter().enumerate() {
+            key[n + s] = key[n + s].min(v);
+            parent_level[s] = if i == 0 { 0 } else { nc[v][i - 1] + 1 };
+            depth[s] = i + 1;
+        }
+    }
+    let mut links: Vec<(usize, usize)> = g
+        .edges
+        .iter()
+        .filter(|e| e.from != e.to)
+        .map(|e| (e.from, e.to))
+        .collect();
+    for (from, to) in rank_only {
+        for &a in from {
+            for &b in to {
+                if a != b {
+                    links.push((a, b));
+                }
+            }
+        }
+    }
+    let mut lev_edges: Vec<Vec<(usize, usize)>> = vec![Vec::new(); ns + 1];
+    for &(u, v) in &links {
+        let cp = nc[u].iter().zip(&nc[v]).take_while(|(a, b)| a == b).count();
+        let lev = if cp == 0 { 0 } else { nc[u][cp - 1] + 1 };
+        let cu = if nc[u].len() == cp { u } else { n + nc[u][cp] };
+        let cv = if nc[v].len() == cp { v } else { n + nc[v][cp] };
+        if cu != cv {
+            lev_edges[lev].push((cu, cv));
+        }
+    }
+    let mut lev_units: Vec<Vec<usize>> = vec![Vec::new(); ns + 1];
+    for v in 0..n {
+        let lev = nc[v].last().map_or(0, |&s| s + 1);
+        lev_units[lev].push(v);
+    }
+    for s in 0..ns {
+        if key[n + s] != usize::MAX {
+            lev_units[parent_level[s]].push(n + s);
+        }
+    }
+    let mut is_lead = vec![false; n + ns];
+    for &l in g.lead_nodes.iter().filter(|&&l| l < n) {
+        is_lead[l] = true;
+    }
+    let mut h = vec![1usize; n + ns];
+    let mut start = vec![0usize; n + ns];
+    // Deepest levels first, the root last.
+    let mut order: Vec<usize> = (0..ns).filter(|&s| key[n + s] != usize::MAX).collect();
+    order.sort_by_key(|&s| (std::cmp::Reverse(depth[s]), s));
+    let mut levels: Vec<usize> = order.iter().map(|&s| s + 1).collect();
+    levels.push(0);
+    for &lev in &levels {
+        let mut units = lev_units[lev].clone();
+        units.sort_by_key(|&u| (key[u], u));
+        let k = units.len();
+        let mut idx = std::collections::BTreeMap::new();
+        for (i, &u) in units.iter().enumerate() {
+            idx.insert(u, i);
+        }
+        // Deduplicated adjacency in declaration order of the target.
+        let mut adj: Vec<Vec<usize>> = vec![Vec::new(); k];
+        for &(a, b) in &lev_edges[lev] {
+            let (a, b) = (idx[&a], idx[&b]);
+            if !adj[a].contains(&b) {
+                adj[a].push(b);
+            }
+        }
+        for l in adj.iter_mut() {
+            l.sort_unstable();
+        }
+        let mut indeg0 = vec![0usize; k];
+        for l in &adj {
+            for &b in l {
+                indeg0[b] += 1;
+            }
+        }
+        // Cycle breakers: DFS, the sources first.
+        let mut roots: Vec<usize> = (0..k).filter(|&i| indeg0[i] == 0).collect();
+        roots.extend((0..k).filter(|&i| indeg0[i] != 0));
+        let mut state = vec![0u8; k];
+        let mut dag: Vec<Vec<usize>> = vec![Vec::new(); k];
+        for &r in &roots {
+            if state[r] != 0 {
+                continue;
+            }
+            state[r] = 1;
+            let mut stack = vec![(r, 0usize)];
+            while let Some(&(u, ci)) = stack.last() {
+                if ci < adj[u].len() {
+                    stack.last_mut().unwrap().1 += 1;
+                    let v = adj[u][ci];
+                    match state[v] {
+                        0 => {
+                            dag[u].push(v);
+                            state[v] = 1;
+                            stack.push((v, 0));
+                        }
+                        1 => {
+                            if !dag[v].contains(&u) {
+                                dag[v].push(u); // reversed
+                            }
+                        }
+                        _ => dag[u].push(v),
+                    }
+                } else {
+                    state[u] = 2;
+                    stack.pop();
+                }
+            }
+        }
+        for l in dag.iter_mut() {
+            l.sort_unstable();
+            l.dedup();
+        }
+        let mut indeg = vec![0usize; k];
+        for l in &dag {
+            for &b in l {
+                indeg[b] += 1;
+            }
+        }
+        let src: Vec<bool> = indeg.iter().map(|&d| d == 0).collect();
+        let mut st = vec![0usize; k];
+        let mut q: VecDeque<usize> = (0..k).filter(|&i| indeg[i] == 0).collect();
+        let mut topo = Vec::with_capacity(k);
+        while let Some(u) = q.pop_front() {
+            topo.push(u);
+            for &v in &dag[u] {
+                st[v] = st[v].max(st[u] + h[units[u]]);
+                indeg[v] -= 1;
+                if indeg[v] == 0 {
+                    q.push_back(v);
+                }
+            }
+        }
+        // A source block (or lead card) sinks to its nearest successor.
+        for &u in topo.iter().rev() {
+            let sinks = units[u] >= n || is_lead[units[u]];
+            if src[u] && sinks {
+                if let Some(m) = dag[u].iter().map(|&v| st[v]).min() {
+                    st[u] = st[u].max(m.saturating_sub(h[units[u]]));
+                }
+            }
+        }
+        let height = (0..k).map(|i| st[i] + h[units[i]]).max().unwrap_or(1);
+        for (i, &u) in units.iter().enumerate() {
+            start[u] = st[i];
+        }
+        if lev > 0 {
+            h[n + lev - 1] = height.max(1);
+        }
+    }
+    (0..n)
+        .map(|v| start[v] + nc[v].iter().map(|&s| start[n + s]).sum::<usize>())
+        .collect()
+}
