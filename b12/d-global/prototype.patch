+/// B12 prototype: hierarchical breadth assignment. Deepest block first,
+/// every block is packed on its own: its direct items and its (already
+/// packed, now rigid) child blocks are packed leftmost between its two
+/// walls, which fixes the block's least breadth, then relaxed towards
+/// the weighted median of their links INSIDE the block. A packed block
+/// is one rigid unit of its parent level; the root level packs and
+/// relaxes the top-level blocks, loose nodes and outer channel dummies.
+#[allow(clippy::too_many_arguments)]
+fn block_compact(
+    n: usize,
+    layers: &[Vec<usize>],
+    preds: &[Vec<usize>],
+    succs: &[Vec<usize>],
+    alayer: &[usize],
+    absize: &[f64],
+    apath: &[Vec<usize>],
+    border: &[u8],
+    header_b: Option<&[f64]>,
+    bpos: &mut [f64],
+) {
+    let na = bpos.len();
+    let nsub = apath.iter().flatten().copied().max().map_or(0, |m| m + 1);
+    let sep = |u: usize, v: usize| pair_sep(u, v, n, absize, Some(apath), Some(border), header_b);
+    let mut slot = vec![0usize; na];
+    for lv in layers {
+        for (i, &v) in lv.iter().enumerate() {
+            slot[v] = i;
+        }
+    }
+    let weight = |u: usize, v: usize| match (u < n, v < n) {
+        (true, true) => 1.0,
+        (false, false) => COMPACT_DUMMY_WEIGHT,
+        _ => COMPACT_MIXED_WEIGHT,
+    };
+    // Depth of each block (1 = top level), from the paths.
+    let mut depth = vec![0usize; nsub];
+    for p in apath {
+        for (i, &c) in p.iter().enumerate() {
+            depth[c] = i + 1;
+        }
+    }
+    let mut order: Vec<usize> = (0..nsub).filter(|&c| depth[c] > 0).collect();
+    order.sort_by_key(|&c| (std::cmp::Reverse(depth[c]), c));
+    let mut levels: Vec<Option<usize>> = order.into_iter().map(Some).collect();
+    levels.push(None);
+    // Breadth of each node relative to the origin of the rigid unit it
+    // is part of so far (a packed block's left wall).
+    let mut rel = vec![0.0f64; na];
+    let (wl, wr) = (na + nsub, na + nsub + 1);
+    let nu = na + nsub + 2;
+    for lev in levels {
+        let d = lev.map_or(0, |c| depth[c]);
+        let inside = |v: usize| lev.map_or(true, |c| apath[v].get(d - 1) == Some(&c));
+        let unit = |v: usize| -> usize {
+            if apath[v].len() > d {
+                na + apath[v][d]
+            } else if border[v] != 0 && lev.is_some() {
+                if border[v] == 1 {
+                    wl
+                } else {
+                    wr
+                }
+            } else {
+                v
+            }
+        };
+        let off = |v: usize| if apath[v].len() > d { rel[v] } else { 0.0 };
+        let mem: Vec<usize> = (0..na).filter(|&v| inside(v)).collect();
+        if mem.is_empty() {
+            continue;
+        }
+        let mut members: Vec<Vec<usize>> = vec![Vec::new(); nu];
+        for &v in &mem {
+            members[unit(v)].push(v);
+        }
+        // 1. Leftmost packing: longest path over the left-of relation.
+        let mut next: Vec<Vec<(usize, f64)>> = vec![Vec::new(); nu];
+        let mut indeg = vec![0usize; nu];
+        for lv in layers {
+            let row: Vec<usize> = lv.iter().copied().filter(|&v| inside(v)).collect();
+            for w in row.windows(2) {
+                let (a, b) = (w[0], w[1]);
+                let (ua, ub) = (unit(a), unit(b));
+                if ua != ub {
+                    next[ua].push((ub, off(a) + sep(a, b) - off(b)));
+                    indeg[ub] += 1;
+                }
+            }
+        }
+        let mut x = vec![0.0f64; nu];
+        let used: Vec<usize> = (0..nu).filter(|&u| !members[u].is_empty()).collect();
+        let mut q: VecDeque<usize> = used.iter().copied().filter(|&u| indeg[u] == 0).collect();
+        // Root level: the first item of a layer starts half its size in.
+        if lev.is_none() {
+            for &u in &q {
+                x[u] = members[u]
+                    .iter()
+                    .map(|&m| absize[m] / 2.0 - off(m))
+                    .fold(0.0, f64::max);
+            }
+        }
+        while let Some(u) = q.pop_front() {
+            for &(v, w) in &next[u] {
+                x[v] = x[v].max(x[u] + w);
+                indeg[v] -= 1;
+                if indeg[v] == 0 {
+                    q.push_back(v);
+                }
+            }
+        }
+        let right = mem
+            .iter()
+            .map(|&m| x[unit(m)] + off(m) + absize[m] / 2.0)
+            .fold(0.0, f64::max);
+        // 2. Relax towards the links inside this level.
+        let mut seen = vec![usize::MAX; nu];
+        for round in 0..COMPACT_SWEEPS {
+            let down = round % 2 == 0;
+            let rightwards = round % 4 < 2;
+            let lorder: Vec<usize> = if down {
+                (0..layers.len()).collect()
+            } else {
+                (0..layers.len()).rev().collect()
+            };
+            for li in lorder {
+                let row: Vec<usize> = layers[li].iter().copied().filter(|&v| inside(v)).collect();
+                let idx: Vec<usize> = if rightwards {
+                    (0..row.len()).collect()
+                } else {
+                    (0..row.len()).rev().collect()
+                };
+                for i in idx {
+                    let u = unit(row[i]);
+                    if seen[u] == round || u == wl || u == wr {
+                        continue;
+                    }
+                    seen[u] = round;
+                    let (mut lo, mut hi) = (f64::NEG_INFINITY, f64::INFINITY);
+                    let mut pull: Vec<(f64, f64)> = Vec::new();
+                    for &m in &members[u] {
+                        let lay = &layers[alayer[m]];
+                        let s = slot[m];
+                        let left = (s > 0).then(|| lay[s - 1]).filter(|&l| inside(l));
+                        let rgt = lay.get(s + 1).copied().filter(|&r| inside(r));
+                        match left {
+                            Some(l) if unit(l) != u => {
+                                lo = lo.max(x[unit(l)] + off(l) + sep(l, m) - off(m));
+                            }
+                            None => lo = lo.max(absize[m] / 2.0 - off(m)),
+                            _ => {}
+                        }
+                        match rgt {
+                            Some(r) if unit(r) != u => {
+                                hi = hi.min(x[unit(r)] + off(r) - sep(m, r) - off(m));
+                            }
+                            None => hi = hi.min(right - absize[m] / 2.0 - off(m)),
+                            _ => {}
+                        }
+                        if border[m] != 0 {
+                            continue;
+                        }
+                        for &w in preds[m].iter().chain(&succs[m]) {
+                            if border[w] == 0
+                                && inside(w)
+                                && unit(w) != u
+                                && alayer[w].abs_diff(alayer[m]) == 1
+                            {
+                                pull.push((x[unit(w)] + off(w) - off(m), weight(m, w)));
+                            }
+                        }
+                    }
+                    if lo > hi || pull.is_empty() {
+                        continue;
+                    }
+                    let want = weighted_median(&mut pull);
+                    let nx = want.max(lo).min(hi);
+                    if nx.is_finite() {
+                        x[u] = nx;
+                    }
+                }
+            }
+        }
+        let out: Vec<(usize, f64)> = mem.iter().map(|&v| (v, x[unit(v)] + off(v))).collect();
+        for (v, b) in out {
+            if lev.is_some() {
+                rel[v] = b;
+            } else {
+                bpos[v] = b;
+            }
+        }
+    }
 }
 
 /// The point that halves the total weight of `(position, weight)`
