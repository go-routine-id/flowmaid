+/// Whether segment `ab` lies wholly outside `r` by its bounding box
+/// (with a hair of margin): [`clip`] would find nothing, so a caller may
+/// skip it without the divisions.
+fn off_box(a: Pt, b: Pt, r: R) -> bool {
+    const HAIR: f64 = 1e-6;
+    a.0.max(b.0) < r.0 - HAIR
