+        e.waypoints.is_empty()
+            && !near(p0.0, p3.0)
+            && !near(p0.1, p3.1)
+            && ((near(c1.0, p0.0) && !near(c1.1, p0.1) && near(c2.1, p3.1) && !near(c2.0, p3.0))
