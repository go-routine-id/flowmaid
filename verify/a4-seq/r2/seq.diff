+        "<text x=\"{:.1}\" y=\"{:.1}\" dy=\"0.33em\" text-anchor=\"middle\" \
+         font-weight=\"bold\" fill=\"{}\">{}</text>\n",
+        fig.label_pos.0,
+        fig.label_pos.1,
+        ink,
+        escape(&b.label)
