flowchart LR
    dns[name server] -->|lookup| gw[gateway]
    dns -->|log| mid[audit log]
    dns -->|forward| px[operator]
    gw -->|copy| a1
    gw -->|serve| a2
    mid -->|store| m1[archive]
    px -->|enter| b1
    mon[monitor] -->|watch| b2
    subgraph A[Standby site<br/>small shared machine<br/>hosts other sites too]
        a1[standby copy]
        a2[public website]
    end
    subgraph B[Staging and production]
        b1[ingress proxy] -->|route| b2[production app]
        b2 -->|push| b3[git server]
    end
