+/// Per node: whether [`fit_bars`] reads its size for a fork/join bar's
+/// length — a state a bar branches to, or a member, however deep, of a
+/// composite one (whose breadth is [`frame_breadth`] of its members).
+/// All `false` without a bar. [`crate::compound`] asks it of each
+/// block's proxy: such a proxy must count at its block's frame as the
+/// static layout draws it, whatever the frame is now.
+pub(crate) fn bar_branches(g: &Graph) -> Vec<bool> {
+    let mut out = vec![false; g.nodes.len()];
+    let is_bar = |end: End| matches!(end, End::Node(v) if g.nodes[v].shape == Shape::ForkBar);
+    if !g.nodes.iter().any(|n| n.shape == Shape::ForkBar) {
+        return out;
+    }
+    // A frame's members and, like `frame_breadth`, those of every frame
+    // nested in it (the walk is bounded by the subgraph count, so a
+    // malformed parent chain cannot loop).
+    let mut mark = |end: End| match end {
+        End::Node(v) => out[v] = true,
+        End::Sub(si) => {
+            for (ci, c) in g.subgraphs.iter().enumerate() {
+                let mut cur = Some(ci);
+                let mut within = false;
+                for _ in 0..=g.subgraphs.len() {
+                    match cur {
+                        Some(x) if x == si => {
+                            within = true;
+                            break;
+                        }
+                        Some(x) => cur = g.subgraphs.get(x).and_then(|s| s.parent),
+                        None => break,
+                    }
+                }
+                if within {
+                    for &v in &c.nodes {
+                        if let Some(o) = out.get_mut(v) {
+                            *o = true;
+                        }
+                    }
+                }
+            }
+        }
+    };
+    for (from, to) in bar_spans(g) {
+        if is_bar(to) {
+            mark(from);
+        }
+        if is_bar(from) {
+            mark(to);
+        }
+    }
+    out
+}
