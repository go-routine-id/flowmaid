+/// Every (from, to) a fork/join bar may span ([`fit_bars`]): the states
+/// the graph's drawn edges join, composite ones (frames) included.
+fn bar_spans(g: &Graph) -> Vec<(End, End)> {
+    g.edges
+        .iter()
+        .filter(|e| bar_counts(g, e))
+        .map(|e| (End::Node(e.from), End::Node(e.to)))
+        .chain(
+            g.sub_edges
+                .iter()
+                .filter(|e| e.from != e.to && e.kind != EdgeKind::Invisible)
+                .map(|e| (e.from, e.to)),
+        )
+        .collect()
+}
