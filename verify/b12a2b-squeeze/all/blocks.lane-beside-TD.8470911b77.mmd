stateDiagram-v2
    direction TB
[*] --> Idle
state Work {
  [*] --> Load
  Load --> Check
  Check --> Fix
  Fix --> Ship
  state Retry {
    [*] --> Plan
    Plan --> Run
    Run --> Report : ok
    Run --> Verify : again
    state Gate <<choice>>
    Verify --> Gate
    Gate --> Run : redo
    Gate --> Plan : restart
  }
  Check --> Retry
}
Idle --> Work
