flowchart BT
  subgraph core[Core services]
    s1[Auth] --> s2[Users]
    s1 --> s3[Billing]
    s2 --> s4[Audit]
    s3 --> s4
  end
  subgraph edge[Edge]
    g1[Gateway] --> g2[Router]
  end
  g2 --> s1
  g2 --> s2
  g2 --> s3
  g2 --> s4
  g1 --> s4
  g1 -.-> s1
  ext[Client] --> g1
  ext --> core
  mon[Monitor] -.-> core
  mon -.-> edge
  mon --> s4
