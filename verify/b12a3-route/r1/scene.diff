+/// The point of segment `a`-`b` nearest `p`.
+fn nearest_on_seg(p: (f64, f64), a: (f64, f64), b: (f64, f64)) -> (f64, f64) {
+    let (abx, aby) = (b.0 - a.0, b.1 - a.1);
+    let len2 = abx * abx + aby * aby;
+    if len2 <= f64::EPSILON {
+        return a;
+    }
+    let t = (((p.0 - a.0) * abx + (p.1 - a.1) * aby) / len2).clamp(0.0, 1.0);
+    (a.0 + t * abx, a.1 + t * aby)
+}
