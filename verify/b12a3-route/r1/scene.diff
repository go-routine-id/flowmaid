+        Side::Top => (fx + along(p.0 - o.x, hw), fy - hh),
+        Side::Bottom => (fx + along(p.0 - o.x, hw), fy + hh),
+        Side::Left => (fx - hw, fy + along(p.1 - o.y, hh)),
