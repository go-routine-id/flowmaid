+/// Most drawings [`LAID_SCENES`] holds before it drops the one kept
+/// longest: a host's few open diagrams, few enough to compare against on
+/// each [`route`]. Past it a drawing is laid out again the next time it
+/// is routed; the result is the same.
+const LAID_SCENES_MAX: usize = 8;
+
+thread_local! {
+    /// The static drawing of each part [`route`] drew in block mode
+    /// ([`route_from_layout`]), kept by [`laid_scene`]. A memo of a pure
+    /// function (the layout of the graph for these sizes and labels): a
+    /// drawing found here and one laid out again are the same, so the
+    /// output stays deterministic whether or not `scene()` ran on this
+    /// thread before; only the first `route()` of a graph pays for its
+    /// layout. This is the one piece of the layout `route()` reads (the
+    /// layout's chain columns and the frames they widened, which
+    /// `route()` has no layout to place); it is crate-private and never
+    /// part of a [`Scene`] a host sees. Forgotten when the block
+    /// layout's switch or the ordering's start count changes
+    /// ([`forget_laid_scenes`]), which the key does not hold.
+    static LAID_SCENES: std::cell::RefCell<Vec<LaidScene>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Whether [`route`] of `g` (for these fitted `sizes` and `labels`)
+/// starts from a static drawing that draws as `base` does
+/// ([`route_from_layout`]): the block layout's switch and block mode on,
+/// a part the compound layout does not split, and [`LAID_SCENES`]
+/// holding that drawing already (nothing is laid out to
+/// find out). Then a drag `route_partial` draws from `base` and the one
+/// `route()` draws are the same frame.
+fn laid_is(g: &Graph, sizes: &[(f64, f64)], labels: &[String], base: &Scene) -> bool {
+    if !(route_blocks(g, crate::levels::blocks_on()) && crate::compound::split(g).is_none()) {
+        return false;
+    }
+    let starts = crate::levels::order_starts();
+    LAID_SCENES.with(|m| {
+        m.borrow().iter().any(|l| {
+            l.starts == starts
+                && l.sizes == sizes
+                && l.labels == labels
+                && l.g == *g
+                && same_drawing(&l.scene, base)
+        })
+    })
+}
+
+/// Whether `a` and `b` draw the same geometry: node boxes, edge paths
+/// and label spots, frames.
+fn same_drawing(a: &Scene, b: &Scene) -> bool {
+    a.nodes.len() == b.nodes.len()
+        && a.edges.len() == b.edges.len()
+        && a.clusters.len() == b.clusters.len()
+        && a.nodes
+            .iter()
+            .zip(&b.nodes)
+            .all(|(p, q)| (p.x, p.y, p.w, p.h) == (q.x, q.y, q.w, q.h))
+        && a.edges.iter().zip(&b.edges).all(|(p, q)| {
+            p.bezier == q.bezier
+                && p.waypoints == q.waypoints
+                && p.label.as_ref().map(|l| l.1) == q.label.as_ref().map(|l| l.1)
+        })
+        && a.clusters
+            .iter()
+            .zip(&b.clusters)
+            .all(|(p, q)| p.id == q.id && (p.x, p.y, p.w, p.h) == (q.x, q.y, q.w, q.h))
+}
