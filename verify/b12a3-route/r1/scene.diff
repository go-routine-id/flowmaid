+/// A part's static drawing as [`scene`] makes it, by everything that
+/// layout reads: the graph, the node sizes (fitted bars included) and
+/// labels, and the ordering's start count a report may set.
+struct LaidScene {
+    g: Graph,
+    sizes: Vec<(f64, f64)>,
+    labels: Vec<String>,
+    starts: Option<usize>,
+    scene: std::rc::Rc<Scene>,
+}
