+        let (a, z) = (len(&was, k), len(&c, k));
+        if a.abs() > EPS && a * z < 0.0 {
+            return None;
+        }
+        let end_leg = k == 0 || k == n - 2;
+        if end_leg && z.abs() < FOLLOW_END_MIN && z.abs() < a.abs() - EPS {
+            return None;
+        }
