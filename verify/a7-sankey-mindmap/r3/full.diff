+/// CIE76 colour difference; `None` when either colour is unreadable.
+fn delta_e(a: &str, b: &str) -> Option<f64> {
+    let (p, q) = (lab(a)?, lab(b)?);
+    Some(((p[0] - q[0]).powi(2) + (p[1] - q[1]).powi(2) + (p[2] - q[2]).powi(2)).sqrt())
+}
