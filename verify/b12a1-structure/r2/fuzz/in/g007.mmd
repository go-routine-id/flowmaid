flowchart TD
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
    bn2[B 2]
    subgraph Bx[Block Bx title]
      bxn0[Bx 0]
      bxn1[Bx 1]
    end
  end
  subgraph C[Block C title]
    cn0[C 0]
    cn1[C 1]
    subgraph Cx[Block Cx title]
      cxn0[Cx 0]
      cxn1[Cx 1]
      cxn2[Cx 2]
      cxn3[Cx 3]
    end
  end
  f0([free f0])
  an0 --> an1
  an2 --> an3
  bn0 --> bn1
  bn1 --> bn2
  bxn0 --> bxn1
  cn0 --> cn1
  cxn0 --> cxn1
  cxn1 --> cxn2
  cxn2 --> cxn3
  Bx -->|yes| cn1
  Bx -->|retry| cxn3
  cxn2 -.-> bxn1
  bxn1 -->|no| cxn2
  A --> f0
  f0 -->|yes| bn2
  cn1 -->|no| cxn0
  cn0 --> an3
  an1 -->|no| bxn0
  an1 -.->|retry| B
