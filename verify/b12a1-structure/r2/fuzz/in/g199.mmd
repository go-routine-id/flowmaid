flowchart RL
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
      axn2[Ax 2]
      axn3[Ax 3]
      axn4[Ax 4]
      subgraph Axx[Block Axx title]
        axxn0[Axx 0]
        axxn1[Axx 1]
      end
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
  end
  f0([free f0])
  an0 --> an1
  an1 --> an2
  axn0 --> axn1
  axn1 --> axn2
  axn2 --> axn3
  axxn0 --> axxn1
  Ax -.->|sync| bn1
  an2 ==> axn2
  an2 --> axn2
  Ax --> an0
  an1 --> axxn0
  axxn1 ==> an0
  axn3 ==> an0
  an0 ==> axn2
  Axx -.-> axn0
  bn1 ==> A
  an0 --> axn1
  f0 --> bn0
  axn2 --> f0
  axn0 -.-> an1
