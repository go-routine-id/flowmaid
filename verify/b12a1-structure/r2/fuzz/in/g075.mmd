flowchart LR
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
      axn2[Ax 2]
      axn3[Ax 3]
    end
  end
  subgraph B[Block B title]
