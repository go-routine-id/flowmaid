        bxxn0[Bxx 0]
        bxxn1[Bxx 1]
        bxxn2[Bxx 2]
      end
    end
  end
  f0([free f0])
  f1([free f1])
  an1 --> an2
  an0 --> an2
  axn0 --> axn1
  axn1 --> axn2
  axn2 --> axn3
  bn0 --> bn1
  bn1 --> bn2
  bxn0 --> bxn1
  axn3 -->|no| bxn0
  bxxn2 --> axn3
