  bxn0 -.->|yes| axn0
  bxxn2 ==> bxn1
  bn2 -.-> an1
  axn3 ==> an0
  bn0 -->|retry| an0
  Ax -.-> an2
  f1 --> an0
  axn0 ==> bxxn2
  f0 --> bxxn2
  an0 ==> axn2
  bn2 --> axn0
  axn3 --> an2
  an2 --> bxxn2
