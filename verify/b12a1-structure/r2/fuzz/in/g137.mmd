flowchart LR
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
    bn2[B 2]
  end
  subgraph C[Block C title]
    cn0[C 0]
    cn1[C 1]
    cn2[C 2]
    cn3[C 3]
    cn4[C 4]
    subgraph Cx[Block Cx title]
      cxn0[Cx 0]
      cxn1[Cx 1]
    end
  end
  f0([free f0])
  f1([free f1])
  an0 --> an1
  an1 --> an2
  bn0 --> bn1
  bn1 --> bn2
  cn0 --> cn1
  cn1 --> cn2
  cn3 --> cn4
  cxn0 --> cxn1
  cxn0 --> bn2
  f0 -.-> cn0
  an0 -.->|yes| cn1
  f1 ==> cn0
  cn2 -.->|yes| an3
  cxn0 --> cn4
  bn1 --> A
