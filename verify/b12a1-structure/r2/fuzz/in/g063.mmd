flowchart TD
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
    an4[A 4]
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
    bn2[B 2]
  end
  subgraph C[Block C title]
    cn0[C 0]
    cn1[C 1]
    cn2[C 2]
    cn3[C 3]
    cn4[C 4]
    subgraph Cx[Block Cx title]
      cxn0[Cx 0]
      cxn1[Cx 1]
      cxn2[Cx 2]
      cxn3[Cx 3]
      cxn4[Cx 4]
      subgraph Cxx[Block Cxx title]
        cxxn0[Cxx 0]
        cxxn1[Cxx 1]
      end
    end
  end
  f0([free f0])
  an2 --> an3
  an3 --> an4
  bn0 --> bn1
  bn1 --> bn2
  bn0 --> bn2
  cn0 --> cn1
  cn1 --> cn2
  cn3 --> cn4
  cxn0 --> cxn1
  cxn1 --> cxn2
  cxn3 --> cxn4
  cxn0 --> cxn4
  an1 -.->|yes| Cx
  an0 -->|sync| cxn3
  cn0 --> cxn4
  C --> A
  cn1 -->|no| cxn2
  cxn4 --> an0
  C --> bn1
  cxxn1 -.-> bn2
  Cxx --> cxn1
  cn2 --> cxn0
  cn3 ==> cn4
  cxn1 ==> A
