      bxn0[Bx 0]
      bxn1[Bx 1]
      bxn2[Bx 2]
      bxn3[Bx 3]
    end
  end
  f0([free f0])
  an0 --> an1
  an1 --> an2
  an2 --> an3
  an3 --> an4
  an0 --> an4
  axn0 --> axn1
  bn0 --> bn1
  bxn0 --> bxn1
  bxn2 --> bxn3
  Ax --> an0
  bxn2 --> Ax
  axn1 --> f0
  an2 ==> Ax
  bn1 -->|retry| bxn0
  B -.->|retry| axn1
  f0 --> an3
  bxn3 --> Ax
  bxn1 ==>|sync| bxn3
