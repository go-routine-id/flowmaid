flowchart TD
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
    an4[A 4]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
