flowchart LR
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
    subgraph Bx[Block Bx title]
      bxn0[Bx 0]
      bxn1[Bx 1]
      bxn2[Bx 2]
      bxn3[Bx 3]
      subgraph Bxx[Block Bxx title]
        bxxn0[Bxx 0]
        bxxn1[Bxx 1]
      end
    end
  end
  f0([free f0])
  an0 --> an1
  axn0 --> axn1
  bn0 --> bn1
  bxn0 --> bxn1
  bxn1 --> bxn2
  bxn2 --> bxn3
  bxn0 --> bxn3
  bxxn0 --> bxxn1
  axn0 --> Bxx
  axn0 --> Bx
  Bxx -.-> axn0
  bxxn1 --> bxn2
  Ax ==> Bx
  axn0 -.-> an0
  f0 -->|retry| bn1
  axn0 --> Bxx
  bxxn1 --> axn1
  bxn3 -->|sync| Ax
