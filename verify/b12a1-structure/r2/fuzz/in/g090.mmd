flowchart LR
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
    an4[A 4]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
      axn2[Ax 2]
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
  end
  subgraph C[Block C title]
    cn0[C 0]
    cn1[C 1]
    cn2[C 2]
    cn3[C 3]
    subgraph Cx[Block Cx title]
      cxn0[Cx 0]
      cxn1[Cx 1]
      cxn2[Cx 2]
      cxn3[Cx 3]
    end
  end
  f0([free f0])
  an1 --> an2
  an3 --> an4
  axn1 --> axn2
  axn0 --> axn2
  bn0 --> bn1
  cxn1 --> cxn2
  cxn2 --> cxn3
  cxn0 --> cxn3
  B -->|yes| cxn3
  A --> cxn2
  cn3 ==> an2
  cxn0 ==> f0
  f0 -.-> cn2
  an3 ==> an2
  bn0 --> axn2
  cxn3 -.-> cxn2
  an0 -.-> cn2
  an3 -->|retry| Ax
  cn3 --> cxn1
  cn1 --> cxn0
