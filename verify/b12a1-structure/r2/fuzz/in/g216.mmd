flowchart BT
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
      axn2[Ax 2]
      axn3[Ax 3]
      axn4[Ax 4]
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
  end
  f0([free f0])
  axn0 --> axn1
  axn1 --> axn2
  axn3 --> axn4
  axn0 --> axn4
  bn0 --> bn1
  an1 --> axn2
  axn2 ==> f0
  an1 ==> axn1
  B -->|no| axn0
  f0 ==> bn1
  axn3 -.-> an1
  bn0 ==> A
