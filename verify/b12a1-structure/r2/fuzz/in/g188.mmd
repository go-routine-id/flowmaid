flowchart BT
  subgraph A[Block A title]
    an0[A 0]
    an1[A 1]
    an2[A 2]
    an3[A 3]
    an4[A 4]
    subgraph Ax[Block Ax title]
      axn0[Ax 0]
      axn1[Ax 1]
      subgraph Axx[Block Axx title]
        axxn0[Axx 0]
        axxn1[Axx 1]
        axxn2[Axx 2]
        axxn3[Axx 3]
        axxn4[Axx 4]
      end
    end
  end
  subgraph B[Block B title]
    bn0[B 0]
    bn1[B 1]
  end
  f0([free f0])
  f1([free f1])
  an0 --> an1
  an1 --> an2
  an2 --> an3
  an3 --> an4
  an0 --> an4
  axxn0 --> axxn1
  axxn1 --> axxn2
  axxn0 --> axxn4
  f1 ==> axxn0
  an0 --> an2
  an4 -->|sync| f1
  axxn3 --> bn0
  an2 --> axn0
  axxn0 ==> bn1
  Axx ==> an1
  an3 -.->|no| axn0
  an3 -.-> B
  axn1 -->|no| an1
  B ==> A
