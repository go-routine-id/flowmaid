+        let path = if name.starts_with("examples/") {
+            format!("{root}/{name}.mmd")
+        } else {
+            format!("{root}/tests/fixtures/{name}.mmd")
+        };
+        std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("{path}: {e}"))
