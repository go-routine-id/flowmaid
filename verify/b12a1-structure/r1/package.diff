+/// the first one's ([`BlockOrder::warm`]).
+pub(crate) type OrderSeed = Vec<Vec<(usize, usize)>>;
+
+/// An augmented node's element of an [`OrderSeed`], if it has one (a
+/// wall has none).
+type ElementOf<'a> = &'a dyn Fn(usize) -> Option<(usize, usize)>;
