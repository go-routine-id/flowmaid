+            "subgraph S\na\nsubgraph N\nn1 --> n2\nend\na --> b\nend\nS --> S",
+            "subgraph OUT\no1\nsubgraph IN\ni1 --> i2\nend\nend\nOUT --> IN",
+            "subgraph OUT\nsubgraph IN\ni1 --> i2\nend\no1\nend\nIN --> OUT",
