+    /// Record that node `v` moved from layer `from` to layer `to`.
+    fn moved(&mut self, v: usize, from: usize, to: usize) {
+        for &c in &self.paths[v] {
+            if let Some(k) = self.count.get_mut(&(c, from)) {
+                *k -= 1;
+            }
+            *self.count.entry((c, to)).or_insert(0) += 1;
+        }
+    }
