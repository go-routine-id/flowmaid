+    /// Write the level's units back to their layer in the order `order`
+    /// (indices into `units`), each block's members as they stand.
+    fn place_units(
+        layer: &mut [usize],
+        pos: &mut [f64],
+        units: &[(OrderUnit, usize, usize)],
