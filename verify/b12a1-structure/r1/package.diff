+        };
+        let members: Vec<usize> = order
+            .iter()
+            .flat_map(|&i| layer[units[i].1..units[i].1 + units[i].2].iter().copied())
+            .collect();
+        for (i, v) in members.into_iter().enumerate() {
+            layer[start + i] = v;
+            pos[v] = (start + i) as f64;
+        }
+    }
