flowchart TD
    user([Customer])
    subgraph edge[Edge]
        waf[WAF]
        lb[Load balancer]
    end
    subgraph core[Core platform]
        api[API]
        subgraph jobs[Job runners]
            q[[queue]]
            w1[worker one]
            w2[worker two]
        end
        subgraph store[Storage]
            db[(database)]
            blob[(blobs)]
        end
    end
    subgraph ops[Operations]
        mon[monitor]
        pager[pager]
    end
    blob -->|purge| waf
    user -->|https| waf --> lb
    lb -->|route| api
    pager -->|ack| mon
    w2 -->|upload| blob
    api --> q
    w1 -->|write| db
    mon -.->|scrape| api
    api -->|read| db
    w2 -->|failed job| pager
    store -->|backup report| ops
    db -.->|replay| q
    q --> w1 & w2
    mon -.->|scrape| jobs
