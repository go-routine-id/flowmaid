architecture-beta
    group g0(server)[Data Storage Layer]
    group g1(monitoring)[Frontend]
    group g2(cloud)[Data Storage Layer]
    group g3(cloud)[Frontend]
    service s0(database)[Service 0] in g2
    service s1(cloud)[Service 1] in g1
    service s2(database)[Service 2] in g1
    service s3(internet)[Service 3] in g3
    service s4(cloud)[Service 4] in g0
    s3:R --> L:s2
    s1:B --> T:s4
    s2:L --> R:s4
    s0:B --> T:s4
    s2:B --> T:s3
    s0:R -- L:s4
    s2:T -- B:s0
