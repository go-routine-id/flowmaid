architecture-beta
    group g0(cloud)[Backend Services]
    group g1(database)[Data Storage Layer]
    group g2(monitoring)[Data]
    service s0(cloud)[Service 0] in g1
    service s1(monitoring)[Service 1]
    service s2(disk)[Service 2]
    s1:L --> R:s2
    s2:T -- B:s0
    s2:R --> L:s1
    s0:L --> L:s1
    s1:R --> L:s2
    s1:L -- T:s2
    s1:L --> R:s2
