architecture-beta
    group g0(server)[Data Storage Layer]
    group g1(database)[Observability]
    service s0(disk)[Svc 0] in g0
    service s1(cloud)[Q 1] in g0
    service s2(database)[Web App 2] in g1
    service s3(cloud)[Web App 3] in g0
    service s4(nonsense)[Svc 4] in g1
    service s5(nonsense)[Svc 5] in g0
    service s6(cloud)[PostgreSQL Primary 6] in g0
    service s7(database)[Web App 7]
    service s8(internet)[Svc 8] in g0
    service s9(monitoring)[Q 9] in g0
    service s10(internet)[PostgreSQL Primary 10] in g0
    junction s11
    s4:L --> R:s2
    s9{group}:R --> L:s11
    s1:L -[reads config]- T:s2{group}
    s8:R <--> L:s2
    s0:L -- R:s4
    s0:L --> L:s10
    s1:T -[sync]-> B:s9
    s9{group}:B --> T:s11
    s11:B -[x]-> L:s3
    s0:R <--> L:s10
    s10:T <-[calls]-> T:s1
    s6:T -[x]-> B:s2{group}
    s1{group}:R -[reads config]-> L:s11
    s5:R --> B:s7
