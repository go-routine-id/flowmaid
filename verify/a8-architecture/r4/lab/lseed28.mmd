architecture-beta
    group g0(cloud)[Observability]
    service s0(monitoring)[Svc 0] in g0
    service s1(internet)[Q 1]
    service s2(nonsense)[PostgreSQL Primary 2] in g0
    service s3(internet)[Svc 3] in g0
    junction s4 in g0
