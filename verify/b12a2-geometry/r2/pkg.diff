+/// Per subgraph `(lo, hi, shortfall)`: the grown box and what it grew
+/// by. `None` for a block without members.
+fn f1_breadths(g: &Graph, n: usize, bpos: &[f64], absize: &[f64]) -> Vec<Option<(f64, f64, f64)>> {
