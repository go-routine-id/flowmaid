+    let s = g.subgraphs.iter().find(|s| s.id == id).unwrap();
+    let f = frame_box(sc, id);
+    let m = members_box(g, sc, id);
+    m.1 - f.1 - crate::scene::frame_head_room(&s.title)
+}
