+    for &i in &order {
+        let (mut lo, mut hi) = (f64::INFINITY, f64::NEG_INFINITY);
+        for &v in g.subgraphs[i].nodes.iter().filter(|&&v| v < n) {
+            lo = lo.min(bpos[v] - absize[v] / 2.0);
+            hi = hi.max(bpos[v] + absize[v] / 2.0);
+        }
