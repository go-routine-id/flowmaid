+/// Whether a leg of the path through `corners` (edge `me` with `info`)
+/// comes within `chip_reach` of a title's ink past its chip
+/// ([`World::inks_for`], counted only while [`World::ink_on`]) where the
+/// channel nudge after the repair cannot move it off: the line a chip's
+/// clearance past the ink, on the leg's side of it, is taken by an
+/// accepted edge's parallel leg over the same span, or such a leg lies
+/// between the two. The nudge keeps its legs in their order across a
+/// channel and a stroke's spacing apart, so the leg stays on the ink
+/// (the verifier's twin blocks drawn TD: `a1 --> b1` round `Shipping
+/// and returns desk two`'s chip at the regular width, between the chip
+/// and the frame's pin, which the ports stage stood a chip's clearance
+/// past the ink).
+fn ink_stuck(w: &World, info: &Info, me: usize, corners: &[Pt], acc: &mut Accepted) -> bool {
+    let clear = CHIP_SEP + SEP_AIR;
+    let inks: Vec<R> = w.inks_for(info.ends).collect();
+    for ink in inks {
+        let g = grow(ink, w.chip_reach);
+        for leg in corners.windows(2) {
+            let (a, b) = (leg[0], leg[1]);
+            if off_box(a, b, g) || clip(a, b, g).is_none() {
+                continue;
+            }
+            // (axis across, its line, the span along, the ink's ends
+            // across)
+            let (axis, at, lo, hi, i0, i1) = if (a.0 - b.0).abs() < EPS {
+                (0, a.0, a.1.min(b.1), a.1.max(b.1), ink.0, ink.2)
+            } else if (a.1 - b.1).abs() < EPS {
+                (1, a.1, a.0.min(b.0), a.0.max(b.0), ink.1, ink.3)
+            } else {
+                continue;
+            };
+            let to = if at >= (i0 + i1) / 2.0 { i1 + clear } else { i0 - clear };
+            let probe = grow(bounds(&[a, b]), (to - at).abs() + EDGE_SEP);
+            for id in acc.near(probe, me) {
+                let (_, p, q, _) = acc.segs[id as usize];
+                // Nearly parallel (a simplified rounded path is off by a
+                // pixel or so), at its mean cross position.
+                let (dx, dy) = ((q.0 - p.0).abs(), (q.1 - p.1).abs());
+                let l = norm(dx, dy);
+                let (c, l0, l1) = if axis == 0 && dy / l > PARALLEL_COS {
+                    ((p.0 + q.0) / 2.0, p.1.min(q.1), p.1.max(q.1))
+                } else if axis == 1 && dx / l > PARALLEL_COS {
+                    ((p.1 + q.1) / 2.0, p.0.min(q.0), p.0.max(q.0))
+                } else {
+                    continue;
+                };
+                if l1 <= lo + EPS || l0 >= hi - EPS {
+                    continue;
+                }
+                if (c - to).abs() < EDGE_SPACING + SEP_AIR || (c - at) * (c - to) < 0.0 {
+                    if std::env::var("FMXDUMP").is_ok() {
+                        eprintln!("FMX stuck e{me} leg {a:?}-{b:?} to {to:.1} by {p:?}-{q:?} c {c:.1}");
+                    }
+                    return true;
+                }
+            }
+        }
+    }
+    false
+}
