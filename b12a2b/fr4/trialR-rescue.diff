+
+/// After the channel nudge of a block layout's static scene: every edge
+/// that now comes within reach of a title's bold ink past its chip
+/// ([`World::inks`]) where its path before the repair (`before`,
+/// index-parallel with `sc.edges`) did not, is searched again, round
+/// every title's ink as round its chip ([`World::inks_for`]), and the
+/// new path is taken when it scores better against the scene and the
+/// other edges as drawn, the ink counted ([`Score::ink`]). Returns
+/// whether it redrew an edge (then the ends and channels are spaced
+/// again, see [`crate::edgepass`]).
+///
+/// The repair searches round the chips at the regular width, and the
+/// nudge after it keeps the legs it moves off the ink; but a leg with
+/// no free slab beside it stays where the repair put it (the
+/// verifier's twin blocks drawn TD: `a1 --> b1` round `Shipping and
+/// returns desk two`'s chip, 0.6 px into its ink, between the chip and
+/// the frame's pin, which the ports stage stood a chip's clearance past
+/// the ink; the nudge's spread put the pin past it and its scoring took
+/// both moves back, the pin's for a crossing). Searched round the ink
+/// from the start, the repair drew other edges worse (see [`repair`]),
+/// so only an edge whose graze is the stages' own and still there after
+/// the nudge is searched again.
+pub(crate) fn rescue_inks(
+    g: &Graph,
+    sc: &mut Scene,
+    cx: &Ctx,
+    moved: &mut [bool],
+    before: &[Vec<Pt>],
+) -> bool {
+    let ne = sc.edges.len();
+    if !cx.blocks || ne == 0 || ne > ROUTE_MAX_EDGES || before.len() != ne {
+        return false;
+    }
+    let w = World::new(g, sc, true);
+    if !w.sane() || w.inks.iter().all(Option::is_none) {
+        return false;
+    }
+    let grazed: Vec<bool> = (0..ne)
+        .map(|i| {
+            if cx.fixed.get(i).copied().unwrap_or(false) || before[i].len() < 2 {
+                return false;
+            }
+            let Some(info) = info_of(g, &w, cx, i) else {
+                return false;
+            };
+            let now = w.score(&info, i, &edge_polyline(&sc.edges[i]), None).ink;
+            if std::env::var("FMXDUMP").is_ok() {
+                eprintln!("FMX grazed e{i} now {now} was {}", w.score(&info, i, &before[i], None).ink);
+            }
+            now > w.score(&info, i, &before[i], None).ink
+        })
+        .collect();
+    if !grazed.contains(&true) {
+        return false;
+    }
+    repair_with(g, sc, cx, Mode::Static, moved, Some(&grazed))
+}
