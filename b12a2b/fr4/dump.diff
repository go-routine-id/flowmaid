+fn fmx_dump(sc: &Scene, tag: &str) {
+    if std::env::var("FMXDUMP").is_err() { return; }
+    for (i, e) in sc.edges.iter().enumerate() {
+        let c = crate::router::ortho_corners(e).unwrap_or_else(|| e.waypoints.clone());
+        let s: Vec<String> = c.iter().map(|p| format!("({:.1},{:.1})", p.0, p.1)).collect();
+        eprintln!("FMX {tag} e{i} {}->{} {}", e.from, e.to, s.join(" "));
+    }
+    if tag == "ports" {
+        for ci in 0..sc.clusters.len() {
+            let r = crate::scene::title_head_measured(&sc.clusters, ci, 1e9, false);
+            let k = crate::scene::title_head_measured(&sc.clusters, ci, 1e9, true);
+            eprintln!("FMX chip {ci} {} reg {:.1} {:.1} {:.1} {:.1} ink {:.1}", sc.clusters[ci].title, r.0, r.1, r.2, r.3, k.2);
+        }
+    }
+}
