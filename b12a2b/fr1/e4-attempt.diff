+/// e4 attempt: the straight leg off a breadth side leaves a block holding
+/// the end (not the other) through its lateral wall.
+fn leaves_sideways(cx: &Ctx, frames: &[Rect], (end, other): (EndRef, EndRef), p: Pt, to: f64) -> bool {
+    if !cx.blocks { return false; }
+    let held = |e: EndRef| match e {
+        EndRef::Node(v) => cx.node_frames.get(v).cloned().unwrap_or_default(),
+        EndRef::Frame(c) => cx.frame_anc.get(c).cloned().unwrap_or_default(),
+    };
+    let theirs = held(other);
+    held(end).into_iter().filter(|k| !theirs.contains(k)).filter_map(|k| frames.get(k)).any(|r| {
+        p.1 > r.2 && p.1 < r.3 && p.0 > r.0 && p.0 < r.1
+            && (to > r.1 - BLOCK_BORDER_CLEAR || to < r.0 + BLOCK_BORDER_CLEAR)
+    })
+}
