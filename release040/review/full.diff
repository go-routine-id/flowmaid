+    // From `a` out of its face to `b`, and across that.
+    let out = (b.0 - a.0) * na.0 + (b.1 - a.1) * na.1;
+    let jog = ((b.0 - a.0) * na.1).abs() + ((b.1 - a.1) * na.0).abs();
