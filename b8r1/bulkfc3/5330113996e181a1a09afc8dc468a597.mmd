flowchart RL
    N0(Fetch)
    N1([Emit])
    N2(Done)
    N3[Notify parse]
    N4[Validate fetch]
    N5(Fetch)
    N6{Store archive}
    N7[Validate done]
    N8{Load}
    N9([Retry])
    N0 --> N1
    N1 --> N2
    N2 -->|ok| N3
    N2 --> N4
    N2 -->|fail| N5
    N5 --> N6
    N5 --> N7
    N6 -->|fail| N8
    N6 -->|next| N9
    N4 --> N7
    N4 --> N5
    N0 --> N8
    N7 ==>|back| N2
