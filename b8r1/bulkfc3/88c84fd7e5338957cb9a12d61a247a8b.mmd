flowchart TD
  n0[Node 0]
  n1[Node 1]
  n2[Node 2]
  n3[Node 3]
  n4[Node 4]
  n4 e0@==> n1
  e0@{ curve: linear }
  n3 e1@==> n4
  e1@{ curve: step }
  n1 e2@<--> n2
  e2@{ curve: natural }
  n2 e3@--> n3
  e3@{ curve: step }
  n3 e4@<--> n0
  e4@{ curve: stepAfter }
  linkStyle default stroke-width:15px
