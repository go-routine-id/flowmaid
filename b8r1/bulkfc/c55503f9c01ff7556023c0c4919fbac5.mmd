flowchart TD
  n0[Node 0]
  n1[Node 1]
  n2[Node 2]
  n3[Node 3]
  n4[Node 4]
  n0 e0@<--> n1
  e0@{ curve: stepBefore }
  n1 e1@<--> n3
  e1@{ curve: stepBefore }
  n0 e2@--> n3
  e2@{ curve: stepBefore }
  n0 e3@--> n2
  e3@{ curve: step }
  n3 e4@==> n2
  e4@{ curve: step }
  n1 e5@<--> n2
  e5@{ curve: stepBefore }
  linkStyle default stroke-width:15px
