classDiagram
    direction BT
    class Repo~T~ {
      <<interface>>
      +find(id) T
      +save(item T) void
    }
    class UserRepo
    class OrderRepo
    Repo~T~ <|.. UserRepo
    Repo <|.. OrderRepo
    UserRepo "1" --> "*" User : loads
    OrderRepo "1" --> "*" Order : loads
    User "1" --> "*" Order : places
