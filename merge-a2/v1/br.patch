+        .iter()
+        .zip(&extra)
+        .map(|(&k, x)| jogs[k].want - x)
+        .collect();
+    let mut at = crate::ports::place(&want, step, r_lo, r_hi - extra[m - 1]);
+    for (a, x) in at.iter_mut().zip(&extra) {
