+        at[r] = at[r].max(floor.min(hi)).max(lo).min(hi);
+    }
+    for r in (0..m.saturating_sub(1)).rev() {
+        let (lo, hi) = jogs[order[r]].room;
+        at[r] = at[r]
+            .min((at[r + 1] - gap_to(r + 1)).max(lo))
+            .max(lo)
+            .min(hi);
+    }
+    for (&k, &a) in order.iter().zip(&at) {
+        jogs[k].at = a;
+    }
+}
