+/// Put one channel's jogs (`group`, two or more) on their tracks
+/// ([`place_tracks`]).
+fn place_channel(jogs: &mut [Jog], group: Vec<usize>, blocks: bool) {
+    let lo = group
+        .iter()
+        .map(|&k| jogs[k].span().0)
+        .fold(f64::INFINITY, f64::min);
