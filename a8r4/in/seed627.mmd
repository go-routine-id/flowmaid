architecture-beta
    group g0(nonsense)[Edge]
    group g1(database)[Data Storage Layer]
    service s0(disk)[PostgreSQL Primary 0] in g0
    service s1(database)[Authentication and Authorization Service 1]
    service s2(server)[PostgreSQL Primary 2] in g0
    service s3(cloud)[PostgreSQL Primary 3] in g0
    service s4(internet)[Svc 4] in g0
    service s5(server)[Q 5] in g1
    service s6(database)[Svc 6] in g1
    service s7(disk)[Authentication and Authorization Service 7] in g0
    s0:L <-[replicates to standby]-> R:s4
    s0:R <-[calls]-> L:s3
    s3:L -[reads config]- R:s0
    s2:R --> B:s6{group}
    s3:T --> T:s5
    s6:T -[reads config]- B:s4
    s7:B --> L:s0
