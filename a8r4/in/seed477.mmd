architecture-beta
    group g0(monitoring)[Data]
    group g1(internet)[Data Storage Layer] in g0
    service s0(server)[Web App 0] in g0
    service s1(cloud)[Web App 1] in g1
    service s2(disk)[Authentication and Authorization Service 2]
    service s3(disk)[Web App 3] in g0
    service s4(server)[Web App 4] in g0
    service s5(monitoring)[Svc 5] in g0
    service s6(server)[PostgreSQL Primary 6] in g1
    service s7(internet)[Svc 7]
    service s8(disk)[Svc 8] in g1
    service s9(database)[PostgreSQL Primary 9] in g0
    junction s10 in g0
    junction s11 in g1
    s0:B -[publishes order events]- T:s10
    s4:R --> B:s9
    s10:T <--> B:s1
    s2:T -- B:s6
    s2:B -[x]-> T:s3
    s9:T -[sync]- B:s6
    s5:L -[replicates to standby]- R:s6{group}
    s10{group}:B --> R:s11
    s2:R -- L:s1
    s9:B --> T:s0
    s0:B -- L:s4
    s0:R -[reads config]-> L:s1
    s4:T -[reads config]-> B:s2
