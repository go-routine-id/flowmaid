architecture-beta
group g0(cloud)[Backend Services]
group g1(database)[Frontend]
service s0(internet)[Service 0] in g1
service s1(database)[Service 1] in g0
service s2(cloud)[Service 2] in g1
service s3(database)[Service 3] in g0
