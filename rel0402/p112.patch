+        ts.sections[0].periods[1].events[0] = (wide, y0);
+        assert_eq!(
+            ts.hit_test(x0, y0, 0.0),
+            Some(TimelineHit::Event {
+                section: 0,
+                period: 1,
+                event: 0
+            })
+        );
+    }
