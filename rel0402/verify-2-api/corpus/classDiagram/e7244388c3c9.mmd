classDiagram
  direction LR
  class Hub {
    +id int
    +name String
    +save() bool
  }
  class OrderService {
    +run()
    -state int
  }
  class Cart
  class User {
    +run()
    -state int
  }
  class InventoryRepository
  OrderService --> "many" Hub : owns
  Cart --> "many" Hub : owns
  PaymentGatewayAdapter --> "many" Hub : owns
  User --> "many" Hub : owns
  InventoryRepository --> "many" Hub : owns
  Mailer --> "many" Hub : owns
