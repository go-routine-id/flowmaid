+/// Grow `bb` over every frame and node box.
+fn grow_boxes(bb: &mut Bbox, nodes: &[SceneNode], clusters: &[SceneCluster]) {
+    for c in clusters {
+        bb.add(c.x, c.y);
+        bb.add(c.x + c.w, c.y + c.h);
+    }
+    for n in nodes {
+        bb.add(n.x - n.w / 2.0, n.y - n.h / 2.0);
+        bb.add(n.x + n.w / 2.0, n.y + n.h / 2.0);
     }
 }
 
